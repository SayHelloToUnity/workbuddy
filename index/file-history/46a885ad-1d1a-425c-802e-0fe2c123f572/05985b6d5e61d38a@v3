#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""把已完成的逐集转写合并成一份可检索的合集（按分句重排，便于阅读）。"""
import json
import os
import re

from common import repack, srt_segments

ROOT = os.path.dirname(os.path.abspath(__file__))
TEXT = os.path.join(ROOT, "text")
pages = json.load(open(os.path.join(ROOT, "meta", "pages.json"), encoding="utf-8"))


def chapter_of(title, page):
    m = re.match(r"第([一二三四五六七八])章", title)
    if m:
        return "第%s章" % m.group(1)
    if "复习练习卷" in title:
        return "复习练习卷"
    if "习题课" in title and page >= 96:
        return "电路习题课（电工学）"
    if "复习" in title or "练习" in title:
        return "综合复习"
    return "其他"


out = ["# 《电路原理、电工学》105 集逐字讲稿",
       "",
       "来源：BV1Lb4y1m7vD ｜ UP 主：老游真是太菜了 ｜ 共 105 集 / 35 小时 24 分",
       "转写：本地 Whisper 语音识别，未经人工逐字校对，专有名词可能存在同音误差（如“基尔霍夫”偶被识别为“吉尔霍夫”）。",
       ""]
done = 0
cur = None
for p in pages["pages"]:
    tag = "p%03d" % p["page"]
    srt = os.path.join(TEXT, tag + ".srt")
    segs = srt_segments(srt)
    if not segs:
        continue
    done += 1
    ch = chapter_of(p["part"], p["page"])
    if ch != cur:
        cur = ch
        out += ["", "## " + ch, ""]
    m, s = divmod(p["duration"], 60)
    out += ["### 第 %d 集　%s（%d:%02d）" % (p["page"], p["part"], m, s), ""]
    out += ["\n".join(repack(segs, hi=90)), ""]

out.insert(5, "已完成：%d / %d 集\n" % (done, len(pages["pages"])))
path = os.path.join(ROOT, "逐字讲稿合集.md")
with open(path, "w", encoding="utf-8") as f:
    f.write("\n".join(out))
print("已完成 %d/105 集，输出 逐字讲稿合集.md（%.1f 万字）"
      % (done, len(open(path, encoding="utf-8").read()) / 10000))
