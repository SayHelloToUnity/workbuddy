#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""从逐集讲稿中抽取要点句，生成「逐集要点速览」。抽取式，不改写原意。"""
import json
import os
import re

from common import repack, srt_segments

ROOT = os.path.dirname(os.path.abspath(__file__))
TEXT = os.path.join(ROOT, "text")
pages = json.load(open(os.path.join(ROOT, "meta", "pages.json"), encoding="utf-8"))["pages"]

DOMAIN = ["定义", "定律", "定理", "公式", "结论", "概念", "注意", "记住", "关键", "重点",
          "方法", "步骤", "思路", "判断", "求解", "代入", "推导", "意味着", "所以",
          "因此", "也就是", "必须", "不能", "一定要", "容易错", "区别", "条件是"]


def score(s):
    v = sum(2 for k in DOMAIN if k in s)
    if re.search(r"[=＝]", s):
        v += 3
    if re.search(r"第[一二三]步|首先|其次|最后|综上", s):
        v += 2
    if re.search(r"同学们|我们来看", s):
        v -= 1
    return v


out = ["# 《电路原理、电工学》逐集要点速览", "",
       "来源：BV1Lb4y1m7vD ｜ 105 集 ｜ 基于本地语音转写稿的抽取式提要",
       "用法：每集摘取 4—5 句讲解中的关键话，保留原话，便于定位与回忆；完整表述见《逐字讲稿合集》。", ""]

cur = None
for p in pages:
    srt = os.path.join(TEXT, "p%03d.srt" % p["page"])
    segs = srt_segments(srt)
    if not segs:
        continue
    units = repack(segs, hi=78)
    if not units:
        continue
    ranked = sorted(range(len(units)), key=lambda i: (-score(units[i]), i))[:4]
    pick = sorted(set([0] + ranked))[:5]
    m, s = divmod(p["duration"], 60)
    ch = re.match(r"第([一二三四五六七八])章", p["part"])
    head = "第%s章" % ch.group(1) if ch else ("复习卷与习题课" if p["page"] >= 88 else "其他")
    if head != cur:
        cur = head
        out += ["", "## " + head, ""]
    out += ["**第 %d 集　%s**（%d:%02d）" % (p["page"], p["part"], m, s), ""]
    for i in pick:
        out.append("- " + units[i].rstrip("，,；"))
    out.append("")

path = os.path.join(ROOT, "逐集要点速览.md")
with open(path, "w", encoding="utf-8") as f:
    f.write("\n".join(out))
print("生成 逐集要点速览.md，%d 集" % len(pages))
