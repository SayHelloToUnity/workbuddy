#!/bin/bash
# 分块转写驱动：每块独立进程，避免 CUDA 上下文崩溃后整批失效；末尾多轮补跑失败项。
cd "$(dirname "$0")" || exit 1
export ASR_MODEL=./models/fw-medium
export ASR_DEVICE=cuda
export ASR_COMPUTE=int8_float16
export ASR_BATCH=4

echo "=== RUN START $(date +%H:%M:%S) ===" >> asr.log
for s in 1 11 21 31 41 51 61 71 81 91 101; do
  e=$((s + 9))
  [ "$e" -gt 105 ] && e=105
  echo "=== chunk $s-$e $(date +%H:%M:%S) ===" >> asr.log
  python asr_batch.py "$s-$e" >> asr.log 2>&1
done
for i in 1 2 3; do
  echo "=== retry $i $(date +%H:%M:%S) ===" >> asr.log
  python asr_batch.py todo >> asr.log 2>&1
done
echo "=== ALL DONE $(date +%H:%M:%S) ===" >> asr.log
