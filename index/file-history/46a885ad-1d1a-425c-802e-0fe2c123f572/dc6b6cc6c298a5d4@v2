#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""拉取多P视频全部分集元数据，输出 JSON。"""
import json
import urllib.request

UA = ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
      "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36")
BV = "BV1Lb4y1m7vD"


def get(url):
    req = urllib.request.Request(url, headers={
        "User-Agent": UA,
        "Referer": "https://www.bilibili.com/video/" + BV,
    })
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read().decode("utf-8"))


d = get("https://api.bilibili.com/x/web-interface/view?bvid=" + BV)["data"]
out = {
    "bvid": d["bvid"], "aid": d["aid"], "title": d["title"],
    "owner": d["owner"]["name"], "pubdate": d["pubdate"],
    "desc": d["desc"], "total_parts": len(d["pages"]),
    "total_duration_s": d["duration"],
    "pages": [{"page": p["page"], "cid": p["cid"], "part": p["part"],
               "duration": p["duration"]} for p in d["pages"]],
}
with open("meta/pages.json", "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=1)

total = sum(p["duration"] for p in out["pages"])
print("分P数:", out["total_parts"])
print("总时长: %.1f 小时" % (total / 3600))
print("原标题:", out["title"])
print("UP主:", out["owner"])
