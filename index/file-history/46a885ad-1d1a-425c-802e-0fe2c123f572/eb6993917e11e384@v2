"""B站 WBI 签名 + 视频 AI 摘要（conclusion）接口探测。"""
import hashlib
import json
import sys
import time
import urllib.parse
import urllib.request

UA = ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
      "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36")
BV = "BV1Lb4y1m7vD"
MIXIN_TAB = [46, 47, 18, 2, 53, 8, 23, 32, 15, 50, 10, 31, 58, 3, 45, 35, 27, 43, 5, 49,
             33, 9, 42, 19, 29, 28, 14, 39, 12, 38, 41, 13, 37, 48, 7, 16, 24, 55, 40, 61,
             26, 17, 0, 1, 60, 51, 30, 4, 22, 25, 54, 21, 56, 59, 6, 63, 57, 62, 11, 36,
             20, 34, 44, 52]


def raw_get(url):
    req = urllib.request.Request(url, headers={
        "User-Agent": UA, "Referer": "https://www.bilibili.com/video/" + BV})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read().decode("utf-8"))


def wbi_keys():
    nav = raw_get("https://api.bilibili.com/x/web-interface/nav")
    img = nav["data"]["wbi_img"]["img_url"].rsplit("/", 1)[1].split(".")[0]
    sub = nav["data"]["wbi_img"]["sub_url"].rsplit("/", 1)[1].split(".")[0]
    orig = img + sub
    return "".join(orig[i] for i in MIXIN_TAB)[:32]


def signed(url, params, mixin):
    params = dict(params)
    params["wts"] = int(time.time())
    items = sorted(params.items())
    q = urllib.parse.urlencode([(k, str(v)) for k, v in items])
    params["w_rid"] = hashlib.md5((q + mixin).encode()).hexdigest()
    return url + "?" + urllib.parse.urlencode(
        [(k, str(v)) for k, v in sorted(params.items())])


mixin = wbi_keys()
print("mixinKey:", mixin)

cid = sys.argv[1] if len(sys.argv) > 1 else "402997101"
aid = "632610186"
mid = "2460191"

cands = [
    ("view/conclusion", "https://api.bilibili.com/x/web-interface/view/conclusion/get",
     {"bvid": BV, "cid": cid, "up_mid": mid}),
    ("view/conclusion/v2", "https://api.bilibili.com/x/web-interface/view/conclusion/v2/get",
     {"bvid": BV, "cid": cid, "up_mid": mid}),
]
for name, url, p in cands:
    try:
        d = raw_get(signed(url, p, mixin))
        print("\n==", name, "code=", d.get("code"), d.get("message"))
        print(json.dumps(d.get("data"), ensure_ascii=False)[:1200])
    except Exception as e:
        print("\n==", name, "ERR", e)
