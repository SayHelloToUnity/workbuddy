                Mode = baseUserInfoModel.Mode
// #if !UNITY_EDITOR
//                 Debug = baseUserInfoModel.Debug,
// #endif
            };
#if UNITY_EDITOR
            Debug.Log($"请求手术模板参数:{_req}");
#endif
            if (baseUserInfoModel.LoginType == LoginType.OFFLINE)
            {
                OffLineGetTemplate();
            }
            else
            {
