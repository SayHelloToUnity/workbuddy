        /// <summary>
        ///     离线及编辑器下构造方法
        /// </summary>
        public GlobalModel(string courseCode, int activityFilterFlag, string token, int residueSecond,
            LoginType loginModel, bool isTeacher, bool isShiJiao)
        {
            InitModel();
            _req = new TrainLoadCourseTemplateReq();
            _req.CourseCode = courseCode;
            SingleUser(courseCode, token, activityFilterFlag, residueSecond, isTeacher, isShiJiao);
            RemainingTime.Value = residueSecond;
            TotalTime = RemainingTime.Value;
            LoginTypeValue = loginModel;
            if (loginModel == LoginType.OFFLINE)
            {
                OffLineGetTemplate();
            }
            else
            {
                ProtobufRpcRequest.SetApiToken(baseUserInfoModel.Users[0].Token);
                GetCourseTemplate();
            }

            GetCourseInfo(activityFilterFlag);
            RecordTime();
        }

        private void OffLineGetTemplate()
        {
            Debug.Log("离线模式获取模板");
            try
            {
                if (Application.platform == RuntimePlatform.Android)
                {
                    _facade.StartCoroutine(GetAndroidOfflineData());
                }
                else
                {
                    var fs =
                        new FileStream(
                            BasePathConfig.BundlePath + "DataFloder/" + _facade.CourseCode + "Temp.txt",
                            FileMode.Open);
                    //获取文件大小
                    var size = fs.Length;
                    var array = new byte[size];
                    //将文件读到byte数组中
                    fs.Read(array, 0, array.Length);
                    fs.Close();
                    IMessage im = new TrainLoadCourseTemplateResp();
                    trainLoadCourseTemplateResp = (TrainLoadCourseTemplateResp)im.Descriptor.Parser.ParseFrom(array);
                    //GetOperation(trainLoadCourseTemplateResp);注释：_facade.PreLoadFinish();函数会调用该函数，就不用多次调用了
                    Observable.NextFrame().Subscribe(_ =>
                    {
                        _facade.PreLoadFinish();
                    });
                    Observable.Timer(TimeSpan.FromSeconds(0.5f))
                        .Subscribe(_ => { TextureManager.Instance.GetLocalTexture(); }).AddTo(_facade);
                }
            }
            catch (Exception e)
            {
                Debug.LogError($"加载离线模板出现BUG{e}");
            }
        }

        private IEnumerator GetAndroidOfflineData()
        {
            var path = BasePathConfig.BundlePath + "DataFloder/" + _facade.CourseCode + "Temp.txt";
            var uwr = UnityWebRequest.Get(path);
            yield return uwr.SendWebRequest();
            if (uwr.isDone)
            {
                if (uwr.isHttpError || uwr.isNetworkError)
                    Debug.LogError("下载失败： " + uwr.error);
                else
                    try
                    {
                        IMessage im = new TrainLoadCourseTemplateResp();
                        trainLoadCourseTemplateResp =
                            (TrainLoadCourseTemplateResp)im.Descriptor.Parser.ParseFrom(uwr.downloadHandler.data);
                        GetOperation(trainLoadCourseTemplateResp);
                        Observable.Timer(TimeSpan.FromSeconds(0.5f))
                            .Subscribe(_ => { TextureManager.Instance.GetLocalTexture(); }).AddTo(_facade);
                    }
                    catch (Exception e)
                    {
                        Debug.LogError(e);
                    }
            }
        }

        private void GetCourseTemplate()
        {
            TrainService.LoadCourseTemplate(_facade, _req, resp =>
            {
                if (resp == null)
                {
                    Debug.Log($"获取手术模板失败:{_req.CourseCode}");
                    GetCourseTemplate();
                }
                else
                {
                    if (resp.Rc != ErrorCode.Ok)
                    {
                        Debug.Log($"获取手术模板失败:{_req.CourseCode}");
                        GetCourseTemplate();
                        //EventManager.TriggerEvent(BaseErrorEvent.GetCourseInfoError);
                    }
                    else
                    {
                        Debug.Log($"获取手术模板成功:{_req.CourseCode}");
                        SurgeryTypeValue = resp.Course.SurgeryType;
                        trainLoadCourseTemplateResp = resp;
                        OperationName.Value = trainLoadCourseTemplateResp.Course.Name;
                        _facade.PreLoadFinish();
                    }

                    Debug.Log("RCCODE:" + resp.Rc);
                }
            });
        }

        /// <summary>
        ///     获取手术模式信息
        /// </summary>
        private void GetCourseInfo(int activityFilterFlag)
        {
            if ((ActiveFilterType)(activityFilterFlag & (int)ActiveFilterType.Examination) ==
                ActiveFilterType.Examination)
                CourseMode = CourseModeType.CmExamination;
            else if ((ActiveFilterType)(activityFilterFlag & (int)ActiveFilterType.Train) == ActiveFilterType.Train)
                CourseMode = CourseModeType.CmAdvance;
            else if ((ActiveFilterType)(activityFilterFlag & (int)ActiveFilterType.Teach) == ActiveFilterType.Teach)
                CourseMode = CourseModeType.CmTrain;
            Debug.Log($"activityFilterFlag:{activityFilterFlag} 模式：{CourseMode}");
            _facade.IsHardware = (ActiveFilterType)(activityFilterFlag & (int)ActiveFilterType.Hardware) ==
                                 ActiveFilterType.Hardware;
        }

        /// <summary>
        ///     后台数据是否激活 位与运算筛选权限
        /// </summary>
        /// <param name="activeFilterType">过滤类型</param>
        /// <returns></returns>
        public bool JudgeActiveFilterFlag(int activeFilterType)
        {
            var courseModeType =
                BaseOtherUserInfoModel.isShiJiaoOrDaiJiao && !BaseOtherUserInfoModel.IsTeacher
                    ? CourseModeType.CmTrain
                    : CourseMode;
            switch (courseModeType)
            {
                case CourseModeType.CmTrain:
                    if ((ActiveFilterType)(activeFilterType & (int)ActiveFilterType.Teach) != ActiveFilterType.Teach)
                        return false;
                    break;

                case CourseModeType.CmAdvance:
                    if ((ActiveFilterType)(activeFilterType & (int)ActiveFilterType.Train) != ActiveFilterType.Train)
                        return false;
                    break;

                case CourseModeType.CmExamination:
                    if ((ActiveFilterType)(activeFilterType & (int)ActiveFilterType.Examination) !=
                        ActiveFilterType.Examination) return false;
                    break;

                default:
                    Debug.LogError("三种模式都不是");
                    break;
            }

            if (_facade.IsHardware)
            {
                if ((ActiveFilterType)(activeFilterType & (int)ActiveFilterType.Hardware) ==
                    ActiveFilterType.Hardware) return true;
            }
            else
            {
                if ((ActiveFilterType)(activeFilterType & (int)ActiveFilterType.Software) ==
                    ActiveFilterType.Software) return true;
            }

            return false;
        }

        private void RecordTime()
        {
            Observable.EveryUpdate().Subscribe(_ =>
            {
                _timeScale += Time.deltaTime;
                if (_timeScale >= 1 && RemainingTime.Value >= 0)
                {
                    RemainingTime.Value -= 1;
                    _timeScale = 0;
                }
            }).AddTo(_facade);
            Observable.EveryUpdate().Subscribe(_ =>
            {
                _timeScale2 += Time.deltaTime;
                if (_timeScale2 >= 60)
                {
                    _timeScale2 = 0;
                    //发送一下心跳....偷个懒放这里了
                    var temp = ProtobufRpcRequest.ServiceEndpoint;
                    ProtobufRpcRequest.ServiceEndpoint = ProtobufRpcRequest.NewServiceEndpoint;
                    DataService.TrainHeartBeat(_facade, new TrainHeartBeatReq
                    {
                        CourseCode = baseUserInfoModel.CourseCode,
                        Mode = baseUserInfoModel.Mode,
                        UserId = baseUserInfoModel.Users[0].UID
                    }, delegate
                    {
                        //Debug.Log("发送心跳 TrainHeartBeatReq");
                    }, Guid.NewGuid());
                    ProtobufRpcRequest.ServiceEndpoint = temp;
                }
            }).AddTo(_facade);
        }

        /// <summary>
        ///     考试模式下 判断是否有关键步骤 当前是否可以跳转到下一个环节
        /// </summary>
        /// <param name="currentIndex">当前环节序号</param>
        /// <param name="nextIndex">需要跳转到的环节序号</param>
        /// <returns></returns>
        public bool CanISkipSection(int currentIndex, int nextIndex)
        {
            var boList = new List<BaseOperation>();
            for (var i = currentIndex; i < nextIndex; i++)
            {
                var bl = LinkDic.TryGet(i);
                if (bl != null)
                    foreach (var bs in bl.StepDic.Values)
                    {
                        if (!bs.finished && bs.CourseStep.IsKeyStep &&
                            CourseMode != CourseModeType.CmExamination) return false;

                        boList.AddRange(bs.OperationDic.Values.Where(bo => !bo.Finished));
                        boList.AddRange(from bo in OperationClass.Values
                            from co in bs.CourseStep.Operations
                            where co.Code == bo.courseOperation.Code
                            where !bo.Finished
                            select bo);
                    }
            }

            if (BaseOtherUserInfoModel.isShiJiaoOrDaiJiao &&
                BaseOtherUserInfoModel.IsTeacher == false) //示教模式&&学生机需要提交没有做的错误分项
                foreach (var item in boList)
                {
                    if (string.IsNullOrEmpty(item.NotOperationErrorCode))
                        continue;
                    //学生机提交当前环节步骤操作的结果
                    var trainErrorItemReq = new ReqTrainErrorItem
                    {
                        DeviceID = _facade.globalModel.baseUserInfoModel.DeviceID,
                        VirRoomID = _facade.globalModel.baseUserInfoModel.VirRoomID,
                        TrainID = _facade.globalModel.baseUserInfoModel.TrainID,
                        SelectionID = item.ParentLink.LinkGlobalId,
                        StepID = item.ParentStep.StepGlobalID,
                        OperationID = item.OperationGlobalID,
                        SelectionIndex = item.ParentLink.LinkID,
                        StepIndex = item.ParentStep.StepID,
                        OperationIndex = item.OperationID
                    };
                    var courseScoreRecord = new CourseScoreRecord
                    {
                        ScoreItemCode = item.NotOperationErrorCode
                    };
                    var courseScoreItem =
                        _facade.globalModel.CourseScoreItemDic.TryGet(item.NotOperationErrorCode);
                    courseScoreRecord.Count = (uint)Math.Abs(courseScoreItem.Score);
                    trainErrorItemReq.Data.Add(courseScoreRecord);
                    _facade.shiJiaoModel.ReqSendErrorItem(trainErrorItemReq);
                }

            foreach (var bo in boList)
            {
                var courseScoreItem = CourseScoreItemDic.TryGet(bo.NotOperationErrorCode);
                _facade.scoreModel.AddScoreItem(courseScoreItem, bo);
                _facade.scoreModel.AddUserTimeDic(bo);
            }

            return true;
        }

        /// <summary>
        ///     示教模式跳转的时候重置完成状态
        /// </summary>
        public void ResetFinishState(int currentIndex, int nextIndex)
        {
            var boList = new List<BaseOperation>();
            for (var i = nextIndex; i < currentIndex; i++)
            {
                var bl = LinkDic.TryGet(i);
                bl.isFinished = false;
                if (bl == null) continue;
                foreach (var bs in bl.StepDic.Values)
                {
                    bs.finished = false;
                    foreach (var bo in bs.OperationDic.Values) bo.Finished = false;
                }
            }
        }

        /// <summary>
        ///     获取环节 步骤 操作 数据 并存入字典
        /// </summary>
        /// <param name="resp"></param>
        public void GetOperation(TrainLoadCourseTemplateResp resp)
        {
            if (resp.Items is { Count: > 0 })
                foreach (var courseSection in BranchInfo.BranchSections)
                {
                    CourseSectionDic.Add((int)courseSection.SectionID, courseSection);
                    foreach (var courseStep in courseSection.Steps)
                    {
                        CourseStepDic.Add((int)courseStep.StepID, courseStep);
                        foreach (var courseOperation in courseStep.Operations)
                        {
                            CourseOperationDic.Add(courseOperation.Code, courseOperation);
                            foreach (var courseScoreItem in courseOperation.ScoreItems)
                                CourseScoreItemDic.Add(courseScoreItem.UniqueCode, courseScoreItem);
                        }
                    }
                }
            else
                foreach (var courseSection in resp.Sections)
                {
                    CourseSectionDic.Add((int)courseSection.SectionID, courseSection);
                    foreach (var courseStep in courseSection.Steps)
                    {
                        CourseStepDic.Add((int)courseStep.StepID, courseStep);
                        foreach (var courseOperation in courseStep.Operations)
                        {
                            CourseOperationDic.Add(courseOperation.Code, courseOperation);
                            foreach (var courseScoreItem in courseOperation.ScoreItems)
                                CourseScoreItemDic.Add(courseScoreItem.UniqueCode, courseScoreItem);
                        }
                    }
                }
        }

