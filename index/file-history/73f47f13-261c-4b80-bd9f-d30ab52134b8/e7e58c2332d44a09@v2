        private void SingleUser(string courseCode, string token, int activityFilterFlag, int reserveID, bool isTeacher,
            bool isShiJiao)
        {
            baseUserInfoModel = new BaseUserInfoModel();
            baseUserInfoModel.CourseCode = courseCode;
            baseUserInfoModel.Token = token;
            baseUserInfoModel.DeviceID = 1;
            baseUserInfoModel.RoomID = 1;

            baseUserInfoModel.Mode = activityFilterFlag switch
            {
                33 => 65,
                34 => 66,
                _ => activityFilterFlag
            };
            var baseUser = new BaseUser
            {
                UID = 00000000,
                Username = "妙创医学",
                Token = token,
                Nickname = "妙创医学",
                AvatarURL = "",
                RemainSeconds = 1800,
                ReserveID = reserveID
            };
            BaseUser[] baseUsersArr = { baseUser };
            baseUserInfoModel.Users = baseUsersArr;
            BaseOtherUserInfoModel.IsTeacher = isTeacher;
        }

        /// <summary>
        ///     获取最短的那个预约剩余时间
        /// </summary>
        private void GetRemainingTime()
        {
            long temp = 0;
            foreach (var bu in baseUserInfoModel.Users)
            {
                if (bu.FinishTimestamp > temp) temp = bu.FinishTimestamp;
                AllNickName += bu.Nickname + "  ";
            }

            if (baseUserInfoModel.Users.Length <= 1) AllNickName = baseUserInfoModel.Users[0].Nickname;

            TotalTime = (int)(temp - SystemUtils.GetTimeStamp(true));
            RemainingTime.Value = TotalTime;
            if (RemainingTime.Value <= 0 && LoginTypeValue != LoginType.OFFLINE) Application.Quit();
            if (RemainingTime.Value == 0 && TotalTime == 0 && LoginTypeValue == LoginType.OFFLINE)
            {
                TotalTime = 1800;
                RemainingTime.Value = 1500;
            }
        }
        
