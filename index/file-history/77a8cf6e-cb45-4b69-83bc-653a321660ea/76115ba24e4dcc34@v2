def put_table(anchor_el):
    t = Table(copy.deepcopy(tmpl_tbl), doc._body)
    while len(t.rows) < len(rows):
        t._tbl.append(copy.deepcopy(t.rows[-1]._tr))
    while len(t.rows) > len(rows):
        tr = t.rows[-1]._tr
        tr.getparent().remove(tr)
    widths = [1.4, 2.3, 4.3, 6.6]
    for j, w in enumerate(widths):
        for row in t.rows:
            row.cells[j].width = Cm(w)
    for i, row in enumerate(rows):
        for j, val in enumerate(row):
            cell = t.cell(i, j)
            p = cell.paragraphs[0]
            if p.runs:
                p.runs[0].text = val
                for r in p.runs[1:]:
                    r._element.getparent().remove(r._element)
            else:
                p.add_run(val)
    anchor_el.addnext(t._tbl)
    return t._tbl


