def append_block(anchor_el, paras):
    cur = anchor_el
    for t in paras:
        p = clone_p(tmpl_body, t)
        cur.addnext(p._p)
        cur = p._p
    return cur


def put_caption(anchor_el, text):
    p = clone_p(tmpl_tabcap, text, align=WD_ALIGN_PARAGRAPH.CENTER)
    anchor_el.addnext(p._p)
    return p._p


