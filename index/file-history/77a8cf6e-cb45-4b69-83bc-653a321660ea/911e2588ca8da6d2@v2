SRV = (400, 330, 800, 530)
d.rounded_rectangle(sc(SRV), radius=10 * S, fill=C_SRV_BG, outline=C_SRV_LINE, width=3 * S)
d.text((SRV[0] + 24 * S, SRV[1] + 16 * S), "VPN 服务器（路由和远程访问）", font=F_TITLE, fill=C_SRV_LINE)
d.text((SRV[0] + 24 * S, SRV[1] + 60 * S), "Windows Server 2003 · 域控制器 mc.local", font=F_SMALL, fill=C_SUB)

# 两块网卡标识
d.rounded_rectangle(sc((424, 352, 776, 400)), radius=6 * S, fill="white", outline=C_ZONE_LINE, width=1 * S)
d.text((440 * S, 360 * S), "内网网卡  192.168.10.203   网关 192.168.10.1", font=F_TEXT, fill=C_INK)
d.rounded_rectangle(sc((424, 462, 776, 510)), radius=6 * S, fill="white", outline=C_ZONE_LINE, width=1 * S)
d.text((440 * S, 470 * S), "外网网卡  192.168.40.5     网关 （空）", font=F_TEXT, fill=C_INK)

d.text((424 * S, 412 * S), "承载 IIS 6.0 · 智睿政务问卷调查系统", font=F_SMALL, fill=C_SUB)

# ============ 客户端 ============
CLI = (150, 590, 430, 720)
node(CLI, [
    ("VPN 客户端", F_NODE, C_INK),
    ("拨号前  192.168.40.10", F_TEXT, C_SUB),
    ("拨号后  192.168.10.211", F_TEXT, C_WARN),
    ("网关 192.168.40.5", F_SMALL, C_SUB),
])

# 地址池
node((830, 590, 1080, 700), [
    ("静态地址池", F_NODE, C_INK),
    ("192.168.10.210 – 219", F_TEXT, C_WARN),
    ("拨入后按序分配", F_SMALL, C_SUB),
], outline=C_SRV_LINE, w=2)

# ============ 连线 ============
# 客户端 -> 服务器外网网卡（隧道）
arrow([(290, 590), (290, 530)], color=C_WARN, width=3)
tag(304, 546, "PPTP 隧道  TCP 1723 + GRE", C_WARN, F_SMALL)

# 服务器内网网卡 -> 物理主机
arrow([(600, 330), (600, 300), (300, 300), (300, 268)], color=(58, 110, 76), width=2)
tag(360, 276, "IP 路由转发", (58, 110, 76), F_SMALL)

# 服务器 -> 内网其他主机
arrow([(700, 330), (700, 300), (925, 300), (925, 268)], color=(58, 110, 76), width=2)

# 图例
d.line([(80 * S, 828 * S), (150 * S, 828 * S)], fill=C_WARN, width=3 * S)
d.text((162 * S, 818 * S), "VPN 加密隧道", font=F_SMALL, fill=C_SUB)
d.line([(360 * S, 828 * S), (430 * S, 828 * S)], fill=(58, 110, 76), width=2 * S)
d.text((442 * S, 818 * S), "路由转发路径", font=F_SMALL, fill=C_SUB)
d.text((700 * S, 818 * S), "客户端经隧道获得内网地址，行为等同于内网主机", font=F_SMALL, fill=C_SUB)

out = os.path.join(os.path.dirname(__file__), "vpn_topology.png")
img.resize((W * 2, H * 2), Image.LANCZOS).save(out, dpi=(200, 200))
print("saved", out)
