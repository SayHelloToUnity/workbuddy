# -*- coding: utf-8 -*-
"""把第四章的节标题改成与其他章一致的自动编号 + 继承样式，统一目录显示效果。
输出到新文件，不动主文档。"""
import os, re, copy, shutil
import docx
from docx.oxml import OxmlElement
from docx.oxml.ns import qn

BASE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SRC = os.path.join(BASE, "合并预览_含VPN章.docx")
DST = os.path.join(BASE, "合并预览_v3_目录统一.docx")

shutil.copyfile(SRC, DST)
d = docx.Document(DST)
ps = d.paragraphs

# ---------- 1) 新建一套编号：复制 abstractNum 15，起始 1 ----------
npart = d.part.numbering_part.element
abs_list = npart.findall(qn("w:abstractNum"))
src_abs = [a for a in abs_list if a.get(qn("w:abstractNumId")) == "15"][0]
new_abs = copy.deepcopy(src_abs)
new_abs.set(qn("w:abstractNumId"), "16")
nsid = new_abs.find(qn("w:nsid"))
if nsid is not None:
    nsid.set(qn("w:val"), "77A1B2C3")
abs_list[-1].addnext(new_abs)

new_num = OxmlElement("w:num")
new_num.set(qn("w:numId"), "17")
aid = OxmlElement("w:abstractNumId")
aid.set(qn("w:val"), "16")
new_num.append(aid)
cleanup = npart.find(qn("w:numIdMacAtCleanup"))
if cleanup is not None:
    cleanup.addprevious(new_num)
else:
    npart.findall(qn("w:num"))[-1].addnext(new_num)

# ---------- 2) 第四章 9 个节标题：去手写编号、挂自动编号、清直接格式 ----------
H1 = [158, 172, 187, 197, 207, 217, 234, 249, 268]
fixed = []
for i in H1:
    p = ps[i]
    txt = p.text.strip()
    m = re.match(r"^(\d+)、\s*(.+)$", txt)
    if not m:
        print("!! 跳过（无手写编号）", i, txt)
        continue
    title = m.group(2).strip()
    fixed.append((m.group(1), title))

    for r in list(p.runs):
        r._element.getparent().remove(r._element)
    run = p.add_run(title)
    rp = run._element.get_or_add_rPr()
    for ch in list(rp):
        rp.remove(ch)
    rf = OxmlElement("w:rFonts")
    rf.set(qn("w:hint"), "eastAsia")
    rp.append(rf)

    ppr = p._p.get_or_add_pPr()
    numpr = ppr.get_or_add_numPr()
    ilvl = OxmlElement("w:ilvl"); ilvl.set(qn("w:val"), "0"); numpr.append(ilvl)
    nid = OxmlElement("w:numId"); nid.set(qn("w:val"), "17"); numpr.append(nid)
    ind = ppr.get_or_add_ind()
    ind.set(qn("w:left"), "567")
    ind.set(qn("w:hanging"), "561")
    # pPr 里的段落级 rPr 若存在也清掉
    prpr = ppr.find(qn("w:rPr"))
    if prpr is not None:
        for ch in list(prpr):
            prpr.remove(ch)

print("节标题去编号:", len(fixed))
for n, t in fixed:
    print("   ", n, t)

# ---------- 3) 第四章三级标题：宋体加粗小四，去掉黑体/TNR/下划线 ----------
H2 = [159, 166, 169, 173, 178, 181, 218, 222, 229, 251, 256, 261]
n2 = 0
for i in H2:
    p = ps[i]
    for r in p.runs:
        rp = r._element.get_or_add_rPr()
        for ch in list(rp):
            rp.remove(ch)
        rf = OxmlElement("w:rFonts")
        rf.set(qn("w:ascii"), "Times New Roman")
        rf.set(qn("w:hAnsi"), "Times New Roman")
        rf.set(qn("w:eastAsia"), "宋体")
        rf.set(qn("w:hint"), "eastAsia")
        rp.append(rf)
        rp.append(OxmlElement("w:b"))
        rp.append(OxmlElement("w:bCs"))
        u = OxmlElement("w:u"); u.set(qn("w:val"), "none"); rp.append(u)
        sz = OxmlElement("w:sz"); sz.set(qn("w:val"), "24"); rp.append(sz)
        szcs = OxmlElement("w:szCs"); szcs.set(qn("w:val"), "24"); rp.append(szcs)
    n2 += 1
print("三级标题改格式:", n2)

# ---------- 4) toc 3 样式：去斜体、字号 10.5 磅 ----------
for s in d.styles:
    if s.name == "toc 3":
        rpr = s.element.find(qn("w:rPr"))
        for tag in ("w:i", "w:iCs"):
            e = rpr.find(qn(tag))
            if e is not None:
                rpr.remove(e)
        for tag, val in (("w:sz", "21"), ("w:szCs", "21")):
            e = rpr.find(qn(tag))
            if e is not None:
                e.set(qn("w:val"), val)
        print("toc 3 样式已去斜体")

d.save(DST)
print("已生成", DST, round(os.path.getsize(DST) / 1024 / 1024, 2), "MB")
