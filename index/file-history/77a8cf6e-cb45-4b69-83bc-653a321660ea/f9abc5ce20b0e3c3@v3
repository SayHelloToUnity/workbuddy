def append_block(anchor_el, paras, align=None):
    cur = anchor_el
    for t in paras:
        p = clone_p(tmpl_body, t, align=align)
        cur.addnext(p._p)
        cur = p._p
    return cur


def put_pic(anchor_el, path, width_cm=12.0):
    p = clone_p(tmpl_body, "")
    pf = p.paragraph_format
    pf.first_line_indent = Pt(0)
    pf.left_indent = Pt(0)
    pf.space_before = Pt(6)
    pf.space_after = Pt(3)
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p.add_run().add_picture(path, width=Cm(width_cm))
    anchor_el.addnext(p._p)
    return p._p


def put_caption(anchor_el, text):
    p = clone_p(tmpl_cap, text, align=WD_ALIGN_PARAGRAPH.CENTER)
    anchor_el.addnext(p._p)
    return p._p


def put_table_caption(anchor_el, text):
    p = clone_p(tmpl_tabcap, text, align=WD_ALIGN_PARAGRAPH.CENTER)
    anchor_el.addnext(p._p)
    return p._p


def put_table(anchor_el):
    t = Table(copy.deepcopy(tmpl_tbl), doc._body)
    tr = t.rows[-1]._tr
    tr.getparent().remove(tr)
    rows = [
        ["路径", "访问地址", "状态码", "首字节", "总耗时", "页面字节"],
        ["内网直连", "192.168.10.203/index.asp", "200", "49.9 ms", "51.5 ms", str(SIZE)],
        ["公网穿透", "garland-flatware-science.ngrok-free.dev", "200", "544.1 ms", "637.7 ms", str(SIZE)],
    ]
    for i, row in enumerate(rows):
        for j, val in enumerate(row):
            cell = t.cell(i, j)
            p = cell.paragraphs[0]
            if p.runs:
                p.runs[0].text = val
                for r in p.runs[1:]:
                    r._element.getparent().remove(r._element)
            else:
                p.add_run(val)
    anchor_el.addnext(t._tbl)
    return t._tbl


