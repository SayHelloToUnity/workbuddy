def write_repo_meta(pkg: Path) -> None:
    """在包内写入 git 元数据与一键脚本（每次重建后仍然存在，且跨机通用）。"""
    (pkg / ".gitattributes").write_text(GITATTRIBUTES, encoding="utf-8")
    gi = pkg / ".gitignore"
    if not gi.exists():
        gi.write_text(GITIGNORE, encoding="utf-8")
    (pkg / "sync.cmd").write_text(SYNC_CMD.replace("\n", "\r\n"), encoding="ascii")
    (pkg / "pull.cmd").write_text(PULL_CMD.replace("\n", "\r\n"), encoding="ascii")


def host_slug() -> str:
    name = os.environ.get("COMPUTERNAME") or os.environ.get("HOSTNAME") or "pc"
    s = "".join(ch if (ch.isalnum() or ch in "-_") else "-" for ch in name).lower()
    return s[:32] or "pc"


def find_git_root(p: Path) -> Path | None:
    cur = p
    for _ in range(6):
        if (cur / ".git").exists():
            return cur
        if cur.parent == cur:
            break
        cur = cur.parent
    return None


def resolve_pkg(repo: Path, dir_name: str | None) -> Path:
    """定位包目录：仓库根即包，或仓库根下的子目录。"""
    if (repo / "manifest.json").exists() or (repo / "db").is_dir():
        return repo
    return repo / (dir_name or "snapshot")


def has_origin_main(gitroot: Path) -> bool:
    code, _ = run_git(["rev-parse", "--verify", "origin/main"], gitroot)
    return code == 0


def commit_all(gitroot: Path, msg: str) -> tuple[bool, str]:
    run_git(["add", "-A"], gitroot)
    code, out = run_git(["commit", "-m", msg], gitroot)
    if code != 0 and ("user.email" in out or "tell me who you are" in out.lower()):
        code, out = run_git([*GIT_ID, "commit", "-m", msg], gitroot)
    if code == 0:
        return True, out
    if "nothing to commit" in out or "无文件要提交" in out or "working tree clean" in out:
        return True, "nothing to commit"
    return False, out


GIT_SSH_DEFAULT = "ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=20"
GIT_TIMEOUT = int(os.environ.get("WB_GIT_TIMEOUT", "300"))


def run_git(args: list[str], cwd: Path, timeout: int | None = None) -> tuple[int, str]:
    """执行 git：强制非交互 + 超时保护。

    这里 stdout/stderr 是被捕获的，任何交互提示（host key 确认、密钥口令、
    https 账号密码）都会被吞掉，进程则无限期静默等待 —— 界面停在上一行输出，
    看起来像「卡住」。因此显式关掉交互通道，让失败变成可读的错误。
    """
    env = dict(os.environ)
    env.setdefault("GIT_TERMINAL_PROMPT", "0")
    env.setdefault("GIT_ASKPASS", "echo")
    env.setdefault("SSH_ASKPASS", "echo")
    env.setdefault("GIT_SSH_COMMAND", GIT_SSH_DEFAULT)
    t = GIT_TIMEOUT if timeout is None else timeout
    try:
        p = subprocess.run(
            ["git", *args],
            cwd=str(cwd),
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            env=env,
            timeout=t,
        )
    except subprocess.TimeoutExpired:
        return 124, f"git {args[0]} 超过 {t} 秒无响应（网络不通或 SSH 认证被阻塞）"
    out = (p.stdout or "") + (p.stderr or "")
    return p.returncode, out.strip()


def cmd_git(home: Path, args) -> None:
    pkg = Path(args.package).expanduser().resolve()
    man = {}
    mf = pkg / "manifest.json"
    if mf.exists():
        try:
            man = json.loads(mf.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            man = {}
    src_host = str((man.get("source") or {}).get("host") or "").lower()
    if src_host and src_host == host_slug().lower() and not getattr(args, "force", False):
        die(
            "这份快照就是本机自己导出的，拉取它只会用旧数据覆盖本机。\n"
            f"  快照来源主机：{man.get('source', {}).get('host')}\n"
            "  应该用 sync.cmd 推送；确实要强制覆盖请加 --force。"
        )

    if not (pkg / "manifest.json").exists():
        die(f"不是有效的迁移包：{pkg}")
    if shutil.which("git") is None:
        die("未检测到 git，请先安装 Git for Windows。")

    (pkg / ".gitattributes").write_text(GITATTRIBUTES, encoding="utf-8")
    gi = pkg / ".gitignore"
    if not gi.exists():
        gi.write_text(GITIGNORE, encoding="utf-8")

    if not (pkg / ".git").exists():
        code, out = run_git(["init", "-b", "main"], pkg)
        if code != 0:
            code, out = run_git(["init"], pkg)
        info(f"git init: {'ok' if code == 0 else out}")

    run_git(["add", "-A"], pkg)
    code, out = run_git(["commit", "-m", f"wb chat snapshot {time.strftime('%Y-%m-%d %H:%M')}"], pkg)
    if code != 0 and ("user.email" in out or "tell me who you are" in out.lower()):
        code, out = run_git(
            ["-c", "user.name=wbmigrate", "-c", "user.email=wbmigrate@local",
             "commit", "-m", "wb chat snapshot"], pkg)
        out = "committed with fallback identity"
    if code == 0:
        info(f"git commit: ok ({out if out.startswith('committed') else 'new snapshot'})")
    elif "nothing to commit" in out or "无文件要提交" in out or "working tree clean" in out:
        info("git commit: 无变化，跳过")
    else:
        info(f"git commit: 失败 -> {out}")

    code, cur_remote = run_git(["remote", "get-url", "origin"], pkg)
    if args.remote:
        if code == 0:
            run_git(["remote", "set-url", "origin", args.remote], pkg)
        else:
            run_git(["remote", "add", "origin", args.remote], pkg)
        cur_remote, code = args.remote, 0
        info(f"remote origin = {args.remote}")

    if code == 0 and cur_remote:
        code, out = run_git(["push", "-u", "origin", "HEAD"], pkg)
        if code == 0:
            info(f"已推送到 {cur_remote}")
        else:
            info("推送失败（常见原因：仓库未创建、缺凭据、网络）：")
            info(out)
            info("")
            info("手工补推：")
            info(f'  cd "{pkg}" && git push -u origin HEAD')
    else:
        info("")
        info("已建仓并提交，但还没有远端。执行一次即可绑定并推送：")
        info(f'  cd "{pkg}"')
        info("  git remote add origin <你的私有仓库地址>")
        info("  git push -u origin HEAD")
        info("")
        info("之后每次同步只需：")
        info(f'  python wbmigrate.py export --all -o "{pkg.parent}" --dir-name "{pkg.name}" --replace')
        info(f'  python wbmigrate.py git "{pkg}"')


