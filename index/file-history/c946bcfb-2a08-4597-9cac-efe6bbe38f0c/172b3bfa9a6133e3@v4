def session_assets(home: Path, session: dict) -> list[tuple[Path, Path]]:
    """返回 (源绝对路径, 包内相对路径) 列表。"""
    enc = session["encoded"]
    sid = session["id"]
    pairs: list[tuple[Path, Path]] = []

    src_base = home / "projects" / enc
    main = src_base / f"{sid}.jsonl"
    if main.exists():
        pairs.append((main, Path("projects") / enc / f"{sid}.jsonl"))

    side = src_base / sid
    if side.is_dir():
        for p in side.rglob("*"):
            if p.is_file():
                pairs.append((p, Path("projects") / enc / sid / p.relative_to(side)))

    rollback = src_base / f"{sid}.file-rollback.ndjson"
    if rollback.exists():
        pairs.append((rollback, Path("projects") / enc / rollback.name))

    for name, folder in (
        ("artifact-index", "index/artifact-index"),
        ("changes-index", "index/changes-index"),
    ):
        f = home / name / f"{sid}.json"
        if f.exists():
            pairs.append((f, Path(folder) / f.name))

    fh = home / "file-history" / sid
    if fh.is_dir():
        for p in fh.rglob("*"):
            if p.is_file():
                pairs.append((p, Path("index/file-history") / sid / p.relative_to(fh)))

    return pairs


KEEP_IN_PKG = {".git", ".gitignore", ".gitattributes", "wbmigrate.py", "sync.cmd", "pull.cmd"}


def hard_rm_tree(path) -> None:
    """逐文件删除目录树。

    不使用 shutil.rmtree：某些运行环境（含 WorkBuddy 的 sandbox shim）会把
    rmtree 改写成「移入回收站」，大批量文件时该操作会失败并抛出 OSError。
    逐文件 os.remove 行为确定，且不产生回收站副作用。
    """
    target = Path(path)
    if not target.exists() and not target.is_symlink():
        return
    if target.is_symlink() or target.is_file():
        try:
            os.remove(win_long(target))
        except FileNotFoundError:
            pass
        return
    for root, dirs, files in os.walk(win_long(target), topdown=False):
        for name in files:
            try:
                os.remove(os.path.join(root, name))
            except FileNotFoundError:
                pass
            except OSError:
                try:
                    os.chmod(os.path.join(root, name), 0o666)
                    os.remove(os.path.join(root, name))
                except OSError:
                    pass
        for name in dirs:
            try:
                os.rmdir(os.path.join(root, name))
            except OSError:
                pass
    try:
        os.rmdir(win_long(target))
    except OSError:
        pass


def clear_package_dir(pkg: Path) -> int:
    """清空包目录内容，但保留 .git 与工具脚本 —— 用于固定目录的增量同步。
    返回删除的条目数。
    """
    n = 0
    for item in pkg.iterdir():
        if item.name in KEEP_IN_PKG:
            continue
        hard_rm_tree(item)
        n += 1
    return n


def cmd_export(home: Path, args) -> None:
    sessions = list_sessions(home)
    if not sessions:
        die("没有可导出的会话。")

    selected: list[dict] = []
    if args.session:
        wanted = {x.lower() for x in args.session}
        selected = [s for s in sessions if s["id"].lower() in wanted or s["id"][:8].lower() in wanted]
    elif args.project:
        kw = [k.lower() for k in args.project]
        selected = [
            s
            for s in sessions
            if any(k in s["cwd"].lower() or k in s["encoded"].lower() or k in s["title"].lower() for k in kw)
        ]
    elif args.all:
        selected = sessions
    else:
        die("请指定范围：--all / --project <关键字> / --session <id>")

    selected = [s for s in selected if s["jsonl_exists"]]
    if not selected:
        die("筛选结果里没有带正文的会话。")

    stamp = time.strftime("%Y%m%d-%H%M%S")
    slug = args.name or ("all" if args.all else (args.project[0] if args.project else "session"))
    slug = "".join(ch if ch.isalnum() or ch in "-_" else "-" for ch in slug)[:40] or "pkg"
    out_root = Path(args.output).expanduser().resolve() if args.output else Path.cwd() / "wb-sync"
    dir_name = args.dir_name or f"pkg-{slug}-{stamp}"
    pkg = out_root / dir_name
    if pkg.exists():
        if not args.replace:
            die(f"目标已存在：{pkg}\n如确需覆盖（会保留 .git），加 --replace")
        removed = clear_package_dir(pkg)
        info(f"已清空旧快照内容（{removed} 项，保留 .git）")
    pkg.mkdir(parents=True, exist_ok=True)

    # 1) 复制文件
    manifest_sessions = []
    total_bytes = 0
    redacted_total = 0
    redacted_files: list[str] = []
    for s in selected:
        copied = []
        for src, rel in session_assets(home, s):
            dst = pkg / rel
            lp_makedirs(dst.parent)
            _hits = copy_scrubbed(src, dst)
            if _hits:
                redacted_total += _hits
                redacted_files.append(rel.as_posix())
            copied.append(rel.as_posix())
            total_bytes += src.stat().st_size
        manifest_sessions.append(
            {
                "id": s["id"],
                "cwd": s["cwd"],
                "encoded": s["encoded"],
                "title": s["title"],
                "status": s["status"],
                "updated_at": s["updated_at"],
                "space_id": s["space_id"],
                "files": copied,
            }
        )

    # 2) 导出数据库行（只导相关行）
    con = connect_ro(home / "workbuddy.db")
    ids = [s["id"] for s in selected]
    marks = ",".join("?" * len(ids))
    db_dir = pkg / "db"
    db_dir.mkdir(exist_ok=True)

    session_rows = fetch_rows(con, "sessions", f"id IN ({marks})", ids)
    space_ids = sorted({r.get("space_id") for r in session_rows if r.get("space_id")})
    space_rows = []
    if space_ids:
        m2 = ",".join("?" * len(space_ids))
        space_rows = fetch_rows(con, "spaces", f"id IN ({m2})", space_ids)

    cwds = sorted({r["cwd"] for r in session_rows if r.get("cwd")})
    ws_rows = []
    if cwds:
        # 注意：workspaces.path 常以反斜杠存储，而 sessions.cwd 用正斜杠，必须归一化后比较
        wanted = {norm_path(c) for c in cwds}
        ws_rows = [r for r in fetch_rows(con, "workspaces") if norm_path(r.get("path") or "") in wanted]

    sf_rows = []
    if space_ids:
        m4 = ",".join("?" * len(space_ids))
        sf_rows = fetch_rows(con, "space_folders", f"space_id IN ({m4})", space_ids)

    usage_rows = fetch_rows(con, "session_usage", f"session_id IN ({marks})", ids)
    con.close()

    for name, rows in (
        ("sessions", session_rows),
        ("spaces", space_rows),
        ("space_folders", sf_rows),
        ("workspaces", ws_rows),
        ("session_usage", usage_rows),
    ):
        (db_dir / f"{name}.json").write_text(
            json.dumps(rows, ensure_ascii=False, indent=2), encoding="utf-8"
        )

    # 3) 可选：工作区文件
    if args.with_files:
        for cwd in cwds:
            src = Path(cwd)
            if not src.is_dir():
                info(f"[跳过] 工作区不存在：{cwd}")
                continue
            dst = pkg / "workspace" / encode_project_dir(cwd)
            info(f"复制工作区文件：{cwd} -> {dst}")
            shutil.copytree(
                src,
                dst,
                dirs_exist_ok=True,
                ignore=shutil.ignore_patterns(".git", "node_modules", "__pycache__", ".venv", "venv"),
            )

    # 4) manifest
    manifest = {
        "tool": TOOL,
        "version": VERSION,
        "created_at": now_iso(),
        "source": {
            "home": str(home),
            "user_id": detect_user_id(home),
            "device_id": detect_device_id(home),
            "host": os.environ.get("COMPUTERNAME") or os.environ.get("HOSTNAME") or "",
            "platform": sys.platform,
        },
        "scope": {"all": bool(args.all), "project": args.project, "session": args.session},
        "projects_meta": [{"cwd": p["path"], "last_opened_at": p["last_opened_at"]} for p in ws_rows],
        "counts": {
            "sessions": len(session_rows),
            "spaces": len(space_rows),
            "workspaces": len(ws_rows),
            "files": sum(len(s["files"]) for s in manifest_sessions),
        },
        "sessions": manifest_sessions,
    }
    (pkg / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8")

    # 把工具本身放进包。若包目录就是脚本所在目录（在克隆里直接 sync），
    # copy2 会因「源与目标同一文件」抛错，旧版因此把脚本永久删掉 —— 这里显式跳过。
    try:
        _src = Path(__file__).resolve()
        _dst = (pkg / "wbmigrate.py").resolve()
        if _src != _dst:
            shutil.copy2(_src, _dst)
    except Exception as e:  # noqa: BLE001
        info(f"[提示] 未能把工具复制进包：{e}")

    # 一键脚本随包发布，克隆端无需额外文件
    try:
        (pkg / "sync.cmd").write_text(SYNC_CMD, encoding="ascii", newline="\r\n")
        (pkg / "pull.cmd").write_text(PULL_CMD, encoding="ascii", newline="\r\n")
    except Exception as e:  # noqa: BLE001
        info(f"[提示] 未能写入一键脚本：{e}")

    write_repo_meta(pkg)

    write_restore_readme(pkg, manifest)

    size = sum(f.stat().st_size for f in pkg.rglob("*") if f.is_file())
    info("")
    info(f"导出完成：{pkg}")
    if redacted_total:
        info(f"  敏感信息脱敏 {redacted_total} 处 / {len(redacted_files)} 个文件（避免被 GitHub 拦截）")
        for _f in redacted_files[:3]:
            info(f"    - {_f}")
    info(f"  会话 {len(session_rows)} 个 / 文件 {manifest['counts']['files']} 个 / 合计 {human(size)}")
    if size > 40 * 1024 * 1024 and not args.with_files:
        info("  注意：包体积偏大，推送到 git 前请确认远端限额（GitHub 单文件 100MB）。")
    info("")
    info("下一步（二选一）：")
    info(f"  1) 直接拷走这个文件夹，在目标机运行：python wbmigrate.py import \"{pkg}\" --apply")
    info(f"  2) 走 git：python wbmigrate.py git \"{pkg}\" --remote <你的私有仓库地址>")
    return pkg


