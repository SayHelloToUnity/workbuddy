def parse_map_cwd(pairs: list[str] | None) -> list[tuple[str, str]]:
    out = []
    for item in pairs or []:
        if "=" not in item:
            die(f"--map-cwd 格式应为 旧路径=新路径，收到：{item}")
        old, new = item.split("=", 1)
        out.append((norm_path(old.strip()), new.strip().replace("\\", "/")))
    # 最长前缀优先，避免 /a 覆盖 /a/b
    out.sort(key=lambda x: len(x[0]), reverse=True)
    return out


def remap_cwd(cwd: str, mapping: list[tuple[str, str]]) -> tuple[str, bool]:
    n = norm_path(cwd)
    for old, new in mapping:
        if n == old:
            return new, True
        if n.startswith(old + "/"):
            # 用原始字符串切片，保留原有大小写；norm_path 不会改变长度
            return new.rstrip("/") + cwd[len(old) :].replace("\\", "/"), True
    return cwd, False


def backup_db(home: Path) -> Path | None:
    db = home / "workbuddy.db"
    if not db.exists():
        return None
    dst_dir = home / "backups" / f"wbmigrate-{time.strftime('%Y%m%d-%H%M%S')}"
    dst_dir.mkdir(parents=True, exist_ok=True)
    for suffix in ("", "-wal", "-shm"):
        f = Path(str(db) + suffix)
        if f.exists():
            shutil.copy2(f, dst_dir / f.name)
    return dst_dir


def cmd_import(home: Path, args) -> None:
    pkg = Path(args.package).expanduser().resolve()
    mpath = pkg / "manifest.json"
    if not mpath.exists():
        die(f"不是有效的迁移包（缺 manifest.json）：{pkg}")
    manifest = json.loads(mpath.read_text(encoding="utf-8"))
    mapping = parse_map_cwd(args.map_cwd)

    target_user = detect_user_id(home)
    src_user = manifest["source"].get("user_id")
    reassign = bool(args.reassign_user) or (bool(args.auto_user) and src_user and target_user and src_user != target_user)

    # 计算计划
    plan = []
    unmapped = []
    for s in manifest["sessions"]:
        new_cwd, mapped = remap_cwd(s["cwd"], mapping)
        if mapping and not mapped:
            unmapped.append(s["cwd"])
        new_enc = encode_project_dir(new_cwd) if new_cwd else s["encoded"]
        dst_dir = home / "projects" / new_enc
        plan.append(
            {
                "id": s["id"],
                "title": s["title"],
                "old_cwd": s["cwd"],
                "new_cwd": new_cwd,
                "old_enc": s["encoded"],
                "new_enc": new_enc,
                "dst_dir": dst_dir,
                "files": s["files"],
                "exists": (dst_dir / f"{s['id']}.jsonl").exists(),
            }
        )

    info(f"迁移包   : {pkg}")
    info(f"来源账号 : {src_user}   本机账号: {target_user}" + ("   → 将改写 user_id" if reassign else ""))
    info(f"目标数据根: {home}")
    info(f"会话数量 : {len(plan)}")
    if mapping:
        info("路径重映射:")
        for old, new in mapping:
            info(f"  {old}  ->  {new}")
    if unmapped:
        info("")
        info("[警告] 以下项目路径没有被任何 --map-cwd 命中，将按原路径写入，可能在侧边栏不可见：")
        for u in sorted(set(unmapped)):
            info(f"  - {u}")
    info("")
    changed = [p for p in plan if norm_path(p["old_cwd"]) != norm_path(p["new_cwd"])]
    if changed:
        info("路径变化明细:")
        seen = set()
        for p in changed:
            key = (p["old_cwd"], p["new_cwd"])
            if key in seen:
                continue
            seen.add(key)
            info(f"  {p['old_cwd']}")
            info(f"    -> {p['new_cwd']}")
        info("")

    dup = [p for p in plan if p["exists"]]
    if dup:
        if args.overwrite:
            info(f"{len(dup)} 个会话本机已存在，将按远端版本覆盖（旧文件自动备份）。")
        else:
            info(f"提示：{len(dup)} 个会话在本机已存在，默认跳过（加 --overwrite 覆盖）。")

    if not args.apply:
        info("")
        info("dry-run 结束，未写入任何内容。确认无误后加 --apply 执行。")
        return

    if not (home / "workbuddy.db").exists():
        die(f"目标机缺少 workbuddy.db，请先启动过一次 WorkBuddy：{home}")

    bk = backup_db(home)
    info(f"已备份数据库 -> {bk}")

    # 写入数据库
    con = connect_rw(home / "workbuddy.db")
    stats = {"spaces": 0, "sessions": 0, "workspaces": 0, "session_usage": 0, "space_folders": 0}
    dirs_to_create = set()
    sf_cleared = set()
    space_alias: dict = {}
    merged_folders: list = []
    try:
        con.execute("BEGIN")

        # --- 本机 device_id：spaces 是「本设备的本地空间」，device_id 写错会被侧边栏过滤掉 ---
        target_device = None
        dev_file = home / "device-id"
        if dev_file.exists():
            try:
                target_device = dev_file.read_text(encoding="utf-8").strip() or None
            except OSError:
                target_device = None
        if not target_device:
            try:
                row = con.execute("SELECT device_id FROM spaces WHERE device_id IS NOT NULL LIMIT 1").fetchone()
                if row:
                    target_device = row[0]
            except sqlite3.Error:
                pass

        # --- 本机已有空间：路径 -> space_id，用于同名项目归并，避免出现两个同名分组 ---
        local_space_paths: dict = {}
        local_space_state: dict = {}
        try:
            for sid, pfp, st, dl in con.execute("SELECT id, primary_folder_path, status, deleted_at FROM spaces"):
                local_space_state[sid] = (st, dl)
                if pfp:
                    local_space_paths[norm_path(pfp)] = sid
            for sid, fp in con.execute("SELECT space_id, path FROM space_folders"):
                if fp:
                    local_space_paths.setdefault(norm_path(fp), sid)
        except sqlite3.Error:
            pass

        # 预读空间目录绑定，供归并判断主路径
        sf_paths_by_space: dict = {}
        _sf_file = pkg / "db" / "space_folders.json"
        if _sf_file.exists():
            for _r in json.loads(_sf_file.read_text(encoding="utf-8")):
                _np, _ = remap_cwd(_r.get("path") or "", mapping)
                sf_paths_by_space.setdefault(_r.get("space_id"), _np)
        for table in ("spaces", "space_folders", "sessions", "workspaces", "session_usage"):
            f = pkg / "db" / f"{table}.json"
            if not f.exists():
                continue
            rows = json.loads(f.read_text(encoding="utf-8"))
            for r in rows:
                if table == "sessions":
                    new_cwd, _ = remap_cwd(r.get("cwd") or "", mapping)
                    r["cwd"] = new_cwd
                    if r.get("space_id") in space_alias:
                        r["space_id"] = space_alias[r["space_id"]]
                    if reassign and target_user:
                        r["user_id"] = target_user
                elif table == "spaces":
                    if reassign and target_user:
                        r["user_id"] = target_user
                    for col in ("primary_folder_path", "create_folder_path"):
                        if r.get(col):
                            r[col], _ = remap_cwd(r[col], mapping)
                            dirs_to_create.add(r[col])
                    if target_device:
                        r["device_id"] = target_device
                    # 本机已有指向同一路径的空间 -> 归并，不新增同名分组
                    _cand = r.get("primary_folder_path") or sf_paths_by_space.get(r.get("id")) or ""
                    _owner = local_space_paths.get(norm_path(_cand)) if _cand else None
                    if _owner and _owner != r.get("id") and args.overwrite:
                        space_alias[r.get("id")] = _owner
                        _st, _dl = local_space_state.get(_owner, ("active", -1))
                        if _st != "active" or _dl not in (-1, None):
                            try:
                                con.execute("UPDATE spaces SET status='active', deleted_at=-1 WHERE id=?", (_owner,))
                            except sqlite3.Error:
                                pass
                        merged_folders.append((_owner, _cand))
                        info(f"  空间归并：{r.get('name')} -> 本机已有空间 {_owner[:8]}")
                        continue
                elif table == "space_folders":
                    _src_sid = r.get("space_id")
                    new_path, _ = remap_cwd(r.get("path") or "", mapping)
                    r["space_id"] = space_alias.get(_src_sid, _src_sid)
                    r["path"] = new_path
                    dirs_to_create.add(new_path)
                    if args.overwrite and _src_sid not in space_alias and r.get("space_id") not in sf_cleared:
                        try:
                            con.execute("DELETE FROM space_folders WHERE space_id=?", (r["space_id"],))
                            sf_cleared.add(r["space_id"])
                        except sqlite3.Error:
                            pass
                elif table == "workspaces":
                    new_cwd, _ = remap_cwd(r.get("path") or "", mapping)
                    if args.overwrite and new_cwd != r.get("path"):
                        try:
                            con.execute("DELETE FROM workspaces WHERE path=?", (r.get("path"),))
                        except sqlite3.Error:
                            pass
                    r["path"] = new_cwd
                res = insert_row(con, table, r, overwrite=args.overwrite)
                if res != "skipped":
                    stats[table] += 1
        for _sid, _path in merged_folders:
            if _path:
                try:
                    con.execute("INSERT OR IGNORE INTO space_folders (space_id, path, sort_order) VALUES (?,?,0)", (_sid, _path))
                except sqlite3.Error:
                    pass
        con.commit()
    except sqlite3.Error as e:
        con.rollback()
        die(f"写入数据库失败，已回滚：{e}")
    finally:
        con.close()

    # 复制正文
    copied = 0
    overwritten = 0
    backup_failed: list[tuple[str, str]] = []
    copy_failed: list[tuple[str, str]] = []
    file_bk_root = (bk or home / "backups") / "files"
    for p in plan:
        p["dst_dir"].mkdir(parents=True, exist_ok=True)
        for rel in p["files"]:
            rel_path = Path(rel)
            # 包里路径含老编码目录，需要替换成新编码
            parts = rel_path.parts
            if len(parts) >= 3 and parts[0] == "projects":
                rel_path = Path("projects") / p["new_enc"] / Path(*parts[2:])
            src = pkg / rel
            dst = home / rel_path
            try:
                lp_makedirs(dst.parent)
                # 覆盖前先备份本机旧文件 —— 「远端为准」策略下的可回退保障
                if dst.exists():
                    try:
                        stored = dst.relative_to(home)
                    except ValueError:
                        stored = Path("_external") / dst.name
                    bk_file = file_bk_root / stored
                    try:
                        lp_makedirs(bk_file.parent)
                        lp_copy(dst, bk_file)
                        overwritten += 1
                    except OSError as e:
                        backup_failed.append((str(dst), str(e)))
                lp_copy(src, dst)
                copied += 1
            except OSError as e:
                copy_failed.append((str(dst), str(e)))

    if getattr(args, "create_dirs", False):
        for pl in plan:
            if pl.get("new_cwd"):
                dirs_to_create.add(pl["new_cwd"])
        made = 0
        for d in sorted(x for x in dirs_to_create if x):
            target = Path(d)
            if target.exists():
                continue
            try:
                target.mkdir(parents=True, exist_ok=True)
                made += 1
            except Exception as e:  # noqa: BLE001
                info(f"[提示] 无法创建目录 {d}：{e}")
        if made:
            info(f"已补建缺失目录 {made} 个（项目文件夹不存在时侧边栏不会显示该项目）")

    info("")
    info("导入完成：")
