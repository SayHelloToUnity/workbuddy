def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="wbmigrate",
        description="WorkBuddy 聊天记录导出 / 迁移 / 还原工具",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--home", help="WorkBuddy 数据根目录（默认 %%USERPROFILE%%\\.workbuddy）")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="列出所有项目与会话及其磁盘文件")
    sub.add_parser("verify", help="体检：检查会话正文是否完整可读")
    sub.add_parser("doctor", help="诊断：项目/会话为何在侧边栏看不到")

    e = sub.add_parser("export", help="导出会话为迁移包")
    e.add_argument("--all", action="store_true", help="导出全部会话")
    e.add_argument("--project", nargs="+", help="按项目路径/标题关键字筛选")
    e.add_argument("--session", nargs="+", help="按会话 id（或前 8 位）筛选")
    e.add_argument("-o", "--output", help="输出到哪个目录（默认 ./wb-sync）")
    e.add_argument("--name", help="包名后缀")
    e.add_argument("--dir-name", help="固定包目录名（配合 --replace 做增量快照，例如 snapshot）")
    e.add_argument("--replace", action="store_true", help="覆盖已存在的同名包（保留 .git）")
    e.add_argument("--with-files", action="store_true", help="同时打包工作区文件")

    i = sub.add_parser("import", help="在目标机还原迁移包")
    i.add_argument("package", help="迁移包目录")
    i.add_argument("--dry-run", action="store_true", help="只预览不写入（不加 --apply 时的默认行为）")
    i.add_argument("--apply", action="store_true", help="真正写入（默认 dry-run）")
    i.add_argument("--overwrite", action="store_true", help="覆盖已存在的同 id 会话")
    i.add_argument("--reassign-user", action="store_true", help="把 user_id 改写为本机账号")
    i.add_argument("--auto-user", action="store_true", help="账号不同时自动改写 user_id")
    i.add_argument("--map-cwd", action="append", help="路径重映射 旧=新，可重复")
    i.add_argument("--create-dirs", action="store_true", help="补建目标机缺失的项目目录（否则侧边栏可能不显示该项目）")

    g = sub.add_parser("git", help="把迁移包初始化成 git 仓库并（可选）推送")
    g.add_argument("package", help="迁移包目录")
    g.add_argument("--remote", help="远端仓库地址，给出则直接 push")

    s = sub.add_parser("sync", help="本机 → 远端：重建快照、提交、推送（远端为准）")
    s.add_argument("--repo", required=True, help="仓库或包目录")
    s.add_argument("--dir-name", help="仓库根不是包时，指定子目录名")
    s.add_argument("--with-files", action="store_true", help="一并同步工作区文件")

    pl = sub.add_parser("pull", help="远端 → 本机：拉取并以覆盖方式写入")
    pl.add_argument("--force", action="store_true", help="即使快照由本机生成也强制拉取")
    pl.add_argument("--repo", required=True, help="仓库或包目录")
    pl.add_argument("--dir-name", help="仓库根不是包时，指定子目录名")
    pl.add_argument("--dry-run", action="store_true", help="只预览不写入")
    pl.add_argument("--map-cwd", action="append", help="手动指定路径映射 旧=新")

    return p


def main(argv: list[str] | None = None) -> int:
    for _stream in (sys.stdout, sys.stderr):
        if hasattr(_stream, "reconfigure"):
            try:
                _stream.reconfigure(errors="replace")
            except Exception:  # noqa: BLE001
                pass

    init_log()
    args = build_parser().parse_args(argv)
    home = find_home(args.home)
    if not home.exists():
        die(f"数据根目录不存在：{home}")

    handlers = {
        "list": cmd_list,
        "verify": cmd_verify,
        "doctor": cmd_doctor,
        "export": cmd_export,
        "import": cmd_import,
        "git": cmd_git,
        "sync": cmd_sync,
        "pull": cmd_pull,
    }
    handlers[args.cmd](home, args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
