def list_sessions(home: Path) -> list[dict]:
    con = connect_ro(home / "workbuddy.db")
    rows = fetch_rows(con, "sessions")
    con.close()
    out = []
    for r in rows:
        cwd = r.get("cwd") or ""
        enc = encode_project_dir(cwd) if cwd else ""
        jsonl = home / "projects" / enc / f"{r['id']}.jsonl" if enc else None
        size = jsonl.stat().st_size if jsonl and jsonl.exists() else 0
        out.append(
            {
                "id": r["id"],
                "cwd": cwd,
                "encoded": enc,
                "title": r.get("custom_title") or r.get("title") or "(无标题)",
                "status": r.get("status"),
                "updated_at": r.get("updated_at") or 0,
                "space_id": r.get("space_id"),
                "jsonl": str(jsonl) if jsonl else None,
                "jsonl_exists": bool(jsonl and jsonl.exists()),
                "size": size,
                "sidecar": str(home / "projects" / enc / r["id"]) if enc else None,
            }
        )
    out.sort(key=lambda x: (x["cwd"], -x["updated_at"]))
    return out


def cmd_list(home: Path, args) -> None:
    sessions = list_sessions(home)
    if not sessions:
        info("没有找到任何会话。")
        return
    db = home / "workbuddy.db"
    info(f"数据根目录 : {home}")
    info(f"会话库     : {db}  ({human(db.stat().st_size) if db.exists() else '缺失'})")
    info(f"会话总数   : {len(sessions)}\n")

    cur_cwd = None
    for s in sessions:
        if s["cwd"] != cur_cwd:
            cur_cwd = s["cwd"]
            enc = s["encoded"] or "(空)"
            info(f"\n▣ 项目：{cur_cwd or '(无 cwd)'}")
            info(f"   projects 目录名：{enc}")
        flag = "OK " if s["jsonl_exists"] else "缺失"
        ts = datetime.fromtimestamp(s["updated_at"] / 1000).strftime("%Y-%m-%d %H:%M") if s["updated_at"] else "-"
        info(f"   [{flag}] {s['id'][:8]}  {ts}  {human(s['size']):>8}  {s['title']}")
        if s["jsonl"]:
            info(f"           {s['jsonl']}")
    missing = [s for s in sessions if not s["jsonl_exists"]]
    info(f"\n合计 {len(sessions)} 个会话，其中 {len(missing)} 个缺少 jsonl 正文。")
    if missing:
        info("提示：缺少正文的会话通常是刚创建未产生内容，或数据已被清理。")


def cmd_verify(home: Path, args) -> None:
    sessions = list_sessions(home)
    bad = []
    for s in sessions:
        if not s["jsonl_exists"]:
            bad.append(s)
            continue
        # 抽查首行是否可解析
        try:
            with open(s["jsonl"], "r", encoding="utf-8") as f:
                first = f.readline()
            json.loads(first)
        except Exception as e:  # noqa: BLE001
            bad.append({**s, "reason": f"首行解析失败: {e}"})
    if not bad:
        info(f"体检通过：{len(sessions)} 个会话全部可读。")
        return
    info(f"发现 {len(bad)} 个异常会话：")
    for s in bad:
        info(f"  - {s['id'][:8]}  {s.get('title')}")
        info(f"    cwd={s['cwd']}")
        info(f"    期望文件={s['jsonl']}")
        if s.get("reason"):
            info(f"    原因={s['reason']}")


def cmd_doctor(home: Path, args) -> None:
    """诊断：项目/会话为何在侧边栏不可见。"""
    db = home / "workbuddy.db"
    if not db.exists():
        die(f"缺少 workbuddy.db：{db}")
    target_device = None
    dev = home / "device-id"
    if dev.exists():
        try:
            target_device = dev.read_text(encoding="utf-8").strip() or None
        except OSError:
            target_device = None

    con = connect_ro(db)
    info(f"数据根    : {home}")
    info(f"本机device: {target_device or '(未找到 device-id)'}")
    info("")

    try:
        spaces = con.execute(
            "SELECT id,name,primary_folder_path,device_id,status,deleted_at FROM spaces"
        ).fetchall()
    except sqlite3.Error as e:
        die(f"读取 spaces 失败：{e}")

    sp_map = {r[0]: r for r in spaces}
    info(f"空间总数  : {len(spaces)}")

    hidden = [r for r in spaces if target_device and r[3] != target_device]
    dead = [r for r in spaces if r[4] != "active" or (r[5] not in (-1, None))]
    if hidden:
        info(f"[问题] {len(hidden)} 个空间的 device_id 与本机不符（侧边栏会过滤掉）：")
        for r in hidden[:6]:
            info(f"    {r[0][:8]}  {r[1]}  device={r[3][:8]}")
    if dead:
        info(f"[问题] {len(dead)} 个空间处于非激活/已删除状态：")
        for r in dead[:6]:
            info(f"    {r[0][:8]}  {r[1]}  status={r[4]} deleted_at={r[5]}")

    try:
        rows = con.execute("SELECT id,cwd,space_id,deleted_at FROM sessions").fetchall()
    except sqlite3.Error as e:
        die(f"读取 sessions 失败：{e}")
    info(f"会话总数  : {len(rows)}")

    orphan = [r for r in rows if r[2] and r[2] not in sp_map]
    missing_space = [r for r in rows if r[2] and r[2] in sp_map and (sp_map[r[2]][4] != "active" or sp_map[r[2]][5] not in (-1, None))]
    deleted = [r for r in rows if r[3] not in (-1, None)]
    if orphan:
        info(f"[问题] {len(orphan)} 个会话的 space_id 指向不存在的空间（会整组隐藏）：")
        for r in orphan[:6]:
            info(f"    {r[0][:8]}  space={r[2][:8]}  {r[1]}")
    if missing_space:
        info(f"[警告] {len(missing_space)} 个会话挂在非激活空间下：")
        for r in missing_space[:6]:
            info(f"    {r[0][:8]}  space={r[2][:8]}  {r[1]}")
    if deleted:
        info(f"[警告] {len(deleted)} 个会话被标记删除：")
        for r in deleted[:6]:
            info(f"    {r[0][:8]}  deleted_at={r[3]}  {r[1]}")

    no_dir = []
    for r in spaces:
        if r[2] and not Path(str(r[2]).replace("/", "\\")).exists():
            no_dir.append(r)
    if no_dir:
        info(f"[提示] {len(no_dir)} 个空间的目录在本机不存在（不影响看历史，但打开会提示路径无效）：")
        for r in no_dir[:6]:
            info(f"    {r[1]}  ->  {r[2]}")

    if not (hidden or dead or orphan or missing_space or deleted):
        info("")
        info("未发现归属/可见性问题。若仍看不到，请确认已完全退出并重启 WorkBuddy。")
    else:
        info("")
        info("修复办法：确认 WorkBuddy 已退出，然后执行 pull（会自动改名 device_id 并归并同名项目）。")


