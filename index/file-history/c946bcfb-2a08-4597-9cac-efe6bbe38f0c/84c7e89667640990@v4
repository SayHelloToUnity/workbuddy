@echo off
setlocal

rem ============================================================
rem  WorkBuddy chat sync: incremental snapshot + git commit/push
rem  Remote: git@github.com:SayHelloToUnity/workbuddy.git (branch main)
rem  Double-click this file, or run it from a cmd window.
rem ============================================================

set "SCRIPT=%~dp0wbmigrate.py"
set "REPO=C:\Users\56583\WorkBuddy\_wb-sync"

where python >nul 2>nul
if errorlevel 1 (
  set "PY=C:\Users\56583\.workbuddy\binaries\python\versions\3.13.12\python.exe"
) else (
  set "PY=python"
)

echo [1/2] Export snapshot ...
"%PY%" "%SCRIPT%" export --all -o "%REPO%" --dir-name snapshot --replace
if errorlevel 1 goto fail

echo.
echo [2/2] Commit and push ...
"%PY%" "%SCRIPT%" git "%REPO%\snapshot"
if errorlevel 1 goto fail

echo.
echo Done.
goto finish

:fail
echo.
echo FAILED. See the output above.

:finish
rem Keep the window open only when launched by double-click (cmdcmdline contains this script name)
echo %cmdcmdline% | find /i "%~nx0" >nul && pause
endlocal
