@echo off
setlocal

rem ============================================================
rem  Upload this machine's chats to the remote repo.
rem  Remote : git@github.com:SayHelloToUnity/workbuddy.git
rem  Target : C:\Users\56583\WorkBuddy\_wb-sync\snapshot
rem  Model  : remote is the source of truth (overwrite on pull)
rem ============================================================

set "REPO=C:\Users\56583\WorkBuddy\_wb-sync\snapshot"
if exist "%~dp0manifest.json" set "REPO=%~dp0."

where python >nul 2>nul
if errorlevel 1 (
  echo Python not found. Install Python 3.8+ first.
  goto fail
)

python "%~dp0wbmigrate.py" sync --repo "%REPO%"
if errorlevel 1 goto fail

echo.
echo Done.
goto finish

:fail
echo.
echo FAILED. Read the output above.

:finish
rem Keep the window open only when launched by double-click
echo %cmdcmdline% | find /i "%~nx0" >nul && pause
endlocal
