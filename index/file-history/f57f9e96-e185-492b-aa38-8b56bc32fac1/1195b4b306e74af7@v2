# -*- coding: utf-8 -*-
"""按同步后的表格重新生成定稿脑图（xmind + mm）"""
import zipfile, os, time
from xml.etree import ElementTree as ET
from collections import OrderedDict

BASE = r'C:/Users/56583/Desktop/静脉输液手术数据'
PATH = os.path.join(BASE, '静脉 输液2026.10.22.xlsx')
NS = '{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'

z = zipfile.ZipFile(PATH)
ss = [''.join(t.text or '' for t in si.iter(NS + 't'))
      for si in ET.fromstring(z.read('xl/sharedStrings.xml'))]
sh = ET.fromstring(z.read('xl/worksheets/sheet1.xml'))
cells = {}
for row in sh.iter(NS + 'row'):
    for c in row.findall(NS + 'c'):
        ref = c.get('r')
        col = ''.join(ch for ch in ref if ch.isalpha())
        rn = int(''.join(ch for ch in ref if ch.isdigit()))
        v = c.find(NS + 'v'); t = c.get('t')
        cells[(rn, col)] = (ss[int(v.text)] if t == 's' else v.text) if v is not None else None

def g(r, c):
    v = cells.get((r, c))
    s = '' if v is None else str(v).strip()
    return s[:-2] if s.endswith('.0') else s

def num(v):
    f = float(v or 0)
    return int(f) if f == int(f) else f

rows = [r for r in range(2, 400) if g(r, 'A')]
tree = OrderedDict()
for r in rows:
    tree.setdefault((g(r, 'I'), g(r, 'J')), OrderedDict()).setdefault(
        (g(r, 'G'), g(r, 'H')), OrderedDict()).setdefault(
        (g(r, 'E'), g(r, 'F')), {'Q': g(r, 'Q'), 'R': g(r, 'R'), 'S': g(r, 'S')})

TOTAL = sum(num(list(tree[k].values())[0]['S']) for k in [])
TOTAL = 0
for k, steps in tree.items():
    TOTAL += num(list(list(steps.values())[0].values())[0]['S'])
print('合计', TOTAL)

ROOT_TITLE = f'静脉输液评分结构  ·  合计 {num(TOTAL)} 分'
root = {'title': ROOT_TITLE, 'children': []}
for (I, J), steps in tree.items():
    S = num(list(list(steps.values())[0].values())[0]['S'])
    en = {'title': f'{I} {J}    {S}分', 'children': []}
    for (G_, H), ops in steps.items():
        R = num(list(ops.values())[0]['R'])
        sn = {'title': f'{G_} {H}    {R}分', 'children': []}
        for (E, F), d in ops.items():
            sn['children'].append({'title': f'{E} {F}    {num(d["Q"])}分', 'children': []})
        en['children'].append(sn)
    root['children'].append(en)

def esc(s):
    return (str(s).replace('&', '&amp;').replace('<', '&lt;')
            .replace('>', '&gt;').replace('"', '&quot;'))

TS = str(int(time.time() * 1000))
_i = [0]
def nid():
    _i[0] += 1
    return '%08x%04x' % (int(time.time() * 1000) % 0xffffffff, _i[0])

def tp(n, structure=None):
    s = f' structure-class="{structure}"' if structure else ''
    out = [f'<topic id="{nid()}"{s} timestamp="{TS}"><title>{esc(n["title"])}</title>']
    if n['children']:
        out.append('<children><topics type="attached">')
        for c in n['children']: out.append(tp(c))
        out.append('</topics></children>')
    out.append('</topic>')
    return ''.join(out)

content = ('<?xml version="1.0" encoding="UTF-8" standalone="no"?>'
           '<xmap-content xmlns="urn:xmind:xmap:xmlns:content:2.0" version="2.0" timestamp="' + TS + '">'
           '<sheet id="' + nid() + '" timestamp="' + TS + '">'
           + tp(root, 'org.xmind.ui.logic.right') +
           '<title>静脉输液评分结构</title></sheet></xmap-content>')
manifest = ('<?xml version="1.0" encoding="UTF-8" standalone="no"?>'
            '<manifest xmlns="urn:xmind:xmap:xmlns:manifest:1.0">'
            '<file-entry full-path="content.xml" media-type="text/xml"/>'
            '<file-entry full-path="META-INF/" media-type=""/>'
            '<file-entry full-path="META-INF/manifest.xml" media-type="text/xml"/>'
            '<file-entry full-path="meta.xml" media-type="text/xml"/>'
            '<file-entry full-path="styles.xml" media-type="text/xml"/></manifest>')
meta = ('<?xml version="1.0" encoding="UTF-8" standalone="no"?>'
        '<meta xmlns="urn:xmind:xmap:xmlns:meta:2.0" version="2.0"/>')
styles = ('<?xml version="1.0" encoding="UTF-8" standalone="no"?>'
          '<xmap-styles xmlns="urn:xmind:xmap:xmlns:style:2.0" version="2.0"><styles/></xmap-styles>')

xp = os.path.join(BASE, '静脉输液评分结构图_100分定稿.xmind')
with zipfile.ZipFile(xp, 'w', zipfile.ZIP_DEFLATED) as zz:
    zz.writestr('content.xml', content)
    zz.writestr('META-INF/manifest.xml', manifest)
    zz.writestr('meta.xml', meta)
    zz.writestr('styles.xml', styles)

def mnode(n, d=0, pos=None):
    p = f' POSITION="{pos}"' if pos else ''
    ind = '  ' * d
    o = [f'{ind}<node TEXT="{esc(n["title"])}"{p}>']
    for c in n['children']: o.append(mnode(c, d + 1))
    o.append(f'{ind}</node>')
    return '\n'.join(o)

mm = '<map version="1.0.1">\n'
mm += '<node TEXT="%s" POSITION="right">\n' % esc(root['title'])
for c in root['children']:
    mm += mnode(c, 1, 'right') + '\n'
mm += '</node>\n</map>\n'
mp = os.path.join(BASE, '静脉输液评分结构图_100分定稿.mm')
open(mp, 'w', encoding='utf-8').write(mm)

print('已生成', os.path.basename(xp), os.path.getsize(xp), 'bytes')
print('已生成', os.path.basename(mp), os.path.getsize(mp), 'bytes')
for c in root['children']:
    print(' ', c['title'])
