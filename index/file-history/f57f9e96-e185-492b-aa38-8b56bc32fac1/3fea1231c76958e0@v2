# -*- coding: utf-8 -*-
"""写入后全面校验"""
import zipfile, re
from xml.etree import ElementTree as ET
from collections import OrderedDict

PATH = r'C:/Users/56583/Desktop/静脉输液手术数据/静脉 输液2026.10.22.xlsx'
BAK = r'C:/Users/56583/Desktop/静脉输液手术数据/静脉 输液2026.10.22.bak-1705.xlsx'
NS = '{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'

def load(p):
    z = zipfile.ZipFile(p)
    ss = [''.join(t.text or '' for t in si.iter(NS + 't'))
          for si in ET.fromstring(z.read('xl/sharedStrings.xml'))]
    sh = ET.fromstring(z.read('xl/worksheets/sheet1.xml'))
    cells = {}
    for row in sh.iter(NS + 'row'):
        for c in row.findall(NS + 'c'):
            ref = c.get('r')
            col = ''.join(ch for ch in ref if ch.isalpha())
            rn = int(''.join(ch for ch in ref if ch.isdigit()))
            v = c.find(NS + 'v'); t = c.get('t')
            val = None
            if v is not None:
                val = ss[int(v.text)] if t == 's' else v.text
            cells[(rn, col)] = val
    return cells

cur = load(PATH)
old = load(BAK)

def g(c, r, col):
    v = c.get((r, col))
    if v is None: return ''
    s = str(v).strip()
    if s.endswith('.0'): s = s[:-2]
    return s

rows = [r for r in range(2, 400) if g(cur, r, 'A')]
print('数据行:', len(rows), rows[0], '-', rows[-1])

# 1) A-P 列是否被误改
diff_ap = []
for r in rows:
    for col in 'ABCDEFGHIJKLMNOP':
        if g(cur, r, col) != g(old, r, col):
            diff_ap.append((r, col, g(old, r, col), g(cur, r, col)))
print('A–P 列改动数:', len(diff_ap))
for d in diff_ap[:10]: print('   ', d)

# 2) 结构 + 闭合校验
env = OrderedDict()
for r in rows:
    key = (g(cur, r, 'I'), g(cur, r, 'J'))
    stk = (g(cur, r, 'G'), g(cur, r, 'H'))
    opk = (g(cur, r, 'E'), g(cur, r, 'F'))
    env.setdefault(key, OrderedDict()).setdefault(stk, {}).setdefault(opk, []).append(r)

total = 0.0
err = []
print()
print('%-4s %-10s %6s %6s | %-4s %-12s %5s %5s' % ('环节', '名称', 'S', 'ΣR', '步骤', '名称', 'R', 'ΣQ'))
for (I, J), steps in env.items():
    s_vals = {g(cur, r, 'S') for st in steps.values() for rs in st.values() for r in rs}
    S = float(list(s_vals)[0]) if len(s_vals) == 1 else None
    if len(s_vals) > 1: err.append('环节 %s S 多值 %s' % (J, s_vals))
    sumR = 0.0
    line = []
    for (G_, H), ops in steps.items():
        r_vals = {g(cur, r, 'R') for rs in ops.values() for r in rs}
        R = float(list(r_vals)[0]) if len(r_vals) == 1 else None
        if len(r_vals) > 1: err.append('步骤 %s/%s R 多值 %s' % (H, G_, r_vals))
        sumQ = 0.0
        for (E, F), rs in ops.items():
            q_vals = {g(cur, r, 'Q') for r in rs}
            if len(q_vals) > 1: err.append('操作 %s Q 多值 %s' % (F, q_vals))
            sumQ += float(list(q_vals)[0])
        sumR += R
        if abs(R - sumQ) > 1e-9:
            err.append('步骤 %s(%s) R=%s ≠ ΣQ=%s' % (H, G_, R, sumQ))
        line.append((G_, H, R, sumQ))
    total += S
    if abs(S - sumR) > 1e-9:
        err.append('环节 %s S=%s ≠ ΣR=%s' % (J, S, sumR))
    print('%-4s %-10s %6s %6s | %-4s %-12s %5s %5s' % (I, J, S, sumR, line[0][0], line[0][1], line[0][2], line[0][3]))
    for l in line[1:]:
        print('%-4s %-10s %6s %6s | %-4s %-12s %5s %5s' % ('', '', '', '', l[0], l[1], l[2], l[3]))

print()
print('=' * 50)
print('全表总分 =', total)
print('闭合/一致性错误数:', len(err))
for e in err: print('  !!', e)

# 3) 格式保留
z = zipfile.ZipFile(PATH)
x = z.read('xl/worksheets/sheet1.xml').decode('utf-8')
print()
print('列宽 cols:', 'YES' if '<cols>' in x else 'NO')
print('冻结窗格:', 'YES' if '<pane' in x else 'NO')
print('表头行样式:', re.search(r'<row r="1"[^>]*>', x).group(0)[:120])
print('dimension:', re.search(r'<dimension ref="[^"]+"', x).group(0))
print('zip 完整性:', '正常' if z.testzip() is None else '异常')
print('文件大小:', __import__('os').path.getsize(PATH))
