# -*- coding: utf-8 -*-
"""把脑图新分值写入 xlsx 的 Q/R/S 三列（直接改 sheet1.xml，保留全部样式）"""
import zipfile, json, re, shutil, os

BASE = r'C:/Users/56583/Desktop/静脉输液手术数据'
SRC = os.path.join(BASE, '静脉 输液2026.10.22.xlsx')
BAK = os.path.join(BASE, '静脉 输液2026.10.22.bak-1705.xlsx')
data = json.load(open(r'C:/Users/56583/AppData/Local/Temp/newscore.json', encoding='utf-8'))
struct = data['struct']

shutil.copy2(SRC, BAK)
print('已备份 ->', os.path.basename(BAK))

z = zipfile.ZipFile(SRC)
items = [(i, z.read(i.filename)) for i in z.infolist()]
z.close()

def fmtnum(v):
    v = round(float(v), 2)
    return str(int(v)) if v == int(v) else str(v)

# 收集目标值
target = {}   # (row, col) -> value
for e in struct:
    for r in e['rows']:
        target[(r, 'S')] = e['newS']
    for s_ in e['steps']:
        for r in s_['rows']:
            target[(r, 'R')] = s_['newR']
        for o in s_['ops']:
            for r in o['rows']:
                target[(r, 'Q')] = o['newQ']

print('待写入单元格数:', len(target))

new_items = []
for info, raw in items:
    if info.filename != 'xl/worksheets/sheet1.xml':
        new_items.append((info, raw))
        continue
    x = raw.decode('utf-8')
    changed = 0
    skip = 0
    for (r, col), val in target.items():
        ref = '%s%d' % (col, r)
        sval = fmtnum(val)
        pat = r'<c r="%s"([^>]*?)(/>|>(.*?)</c>)' % re.escape(ref)
        m = re.search(pat, x)
        if not m:
            print('  !! 找不到单元格', ref); continue
        cur = None
        if m.group(2) != '/>':
            vm = re.search(r'<v>(.*?)</v>', m.group(3) or '')
            if vm: cur = vm.group(1)
        if cur is not None and float(cur) == float(val):
            skip += 1
            continue
        attrs = m.group(1)
        newc = '<c r="%s"%s><v>%s</v></c>' % (ref, attrs, sval)
        x = x[:m.start()] + newc + x[m.end():]
        changed += 1
    print('  sheet1.xml: 实际改动 %d 个，原值已一致 %d 个' % (changed, skip))
    new_items.append((info, x.encode('utf-8')))

OUT = SRC
tmp = OUT + '.tmp'
with zipfile.ZipFile(tmp, 'w', zipfile.ZIP_DEFLATED) as zo:
    for info, raw in new_items:
        zi = zipfile.ZipInfo(info.filename, date_time=info.date_time)
        zi.compress_type = zipfile.ZIP_DEFLATED
        zi.external_attr = info.external_attr
        zo.writestr(zi, raw)
os.replace(tmp, OUT)
print('已保存', OUT, os.path.getsize(OUT), 'bytes')
