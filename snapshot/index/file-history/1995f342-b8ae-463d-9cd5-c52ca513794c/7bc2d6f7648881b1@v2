# -*- coding: utf-8 -*-
"""根据输血评分表生成 环节/步骤/操作 三级脑图（FreeMind .mm + XMind .xmind）"""
import json, os, zipfile, shutil
from collections import OrderedDict
from xml.sax.saxutils import escape

GRID = "grid_final2.json"
OUTDIR = "C:/Users/56583/Desktop/手术数据/静脉输血"
NAME = "静脉输血评分结构图"
XMIND_TPL = "C:/Users/56583/Desktop/手术数据/静脉输液/静脉输液评分结构图_100分定稿.xmind"

d = json.load(open(GRID, encoding='utf-8'))
rows = d['rows']
data = [(i + 2, r) for i, r in enumerate(rows[1:])]
def g(r, c): return str(r[c - 1]).strip()

# ---------------- 构建树 ----------------
tree = OrderedDict()
for ln, r in data:
    h = (g(r, 9), g(r, 10))
    s = (g(r, 7), g(r, 8))
    o = (g(r, 5), g(r, 6))
    tree.setdefault(h, OrderedDict()).setdefault(s, OrderedDict())
    tree[h][s].setdefault(o, float(g(r, 17)))

def fmt(v):
    return ('%g' % v)

total = 0.0
for h, steps in tree.items():
    for s, ops in steps.items():
        for o, q in ops.items():
            total += q

def label(no, nm, v):
    return '%s %s    %s分' % (no, nm, fmt(v))

ROOT_TITLE = '静脉输血评分结构  ·  当前合计 %s 分（目标 100 分）' % fmt(total)

# ---------------- 生成 .mm (FreeMind) ----------------
L = ['<map version="1.0.1">']
L.append('<node TEXT="%s" POSITION="right">' % escape(ROOT_TITLE))
for (hno, hnm), steps in tree.items():
    hs = sum(q for ops in steps.values() for q in ops.values())
    L.append('  <node TEXT="%s" POSITION="right">' % escape(label(hno, hnm, hs)))
    for (sno, snm), ops in steps.items():
        ss = sum(ops.values())
        L.append('    <node TEXT="%s">' % escape(label(sno, snm, ss)))
        for (ono, onm), q in ops.items():
            L.append('      <node TEXT="%s">' % escape(label(ono, onm, q)))
            L.append('      </node>')
        L.append('    </node>')
    L.append('  </node>')
L.append('</node>')
L.append('</map>')
mm = '\n'.join(L)
mm_path = os.path.join(OUTDIR, NAME + '.mm')
open(mm_path, 'w', encoding='utf-8').write(mm)
print('生成', mm_path, len(mm.encode('utf-8')), '字节')

# ---------------- 生成 .xmind (XMind 8 格式) ----------------
tid = [1000]
def nid():
    tid[0] += 1
    return 'ivt%08d' % tid[0]

TS = '1792659745836'
parts = []
parts.append('<?xml version="1.0" encoding="UTF-8" standalone="no"?>'
             '<xmap-content xmlns="urn:xmind:xmap:xmlns:content:2.0" version="2.0" timestamp="%s">' % TS)
parts.append('<sheet id="%s" timestamp="%s"><topic id="%s" structure-class="org.xmind.ui.logic.right" timestamp="%s"><title>%s</title><children><topics type="attached">'
             % (nid(), TS, nid(), TS, escape(ROOT_TITLE)))
for (hno, hnm), steps in tree.items():
    hs = sum(q for ops in steps.values() for q in ops.values())
    parts.append('<topic id="%s" timestamp="%s"><title>%s</title><children><topics type="attached">'
                 % (nid(), TS, escape(label(hno, hnm, hs))))
    for (sno, snm), ops in steps.items():
        ss = sum(ops.values())
        parts.append('<topic id="%s" timestamp="%s"><title>%s</title><children><topics type="attached">'
                     % (nid(), TS, escape(label(sno, snm, ss))))
        for (ono, onm), q in ops.items():
            parts.append('<topic id="%s" timestamp="%s"><title>%s</title></topic>'
                         % (nid(), TS, escape(label(ono, onm, q))))
        parts.append('</topics></children></topic>')
    parts.append('</topics></children></topic>')
parts.append('</topics></children></topic></sheet></xmap-content>')
content = ''.join(parts)

x_path = os.path.join(OUTDIR, NAME + '.xmind')
zt = zipfile.ZipFile(XMIND_TPL)
zo = zipfile.ZipFile(x_path, 'w', zipfile.ZIP_DEFLATED)
for it in zt.infolist():
    if it.filename == 'content.xml':
        zo.writestr('content.xml', content.encode('utf-8'))
    else:
        zo.writestr(it, zt.read(it.filename))
zo.close(); zt.close()
print('生成', x_path, os.path.getsize(x_path), '字节')

# ---------------- 汇总 ----------------
print('\n合计 %s 分 | 环节 %d 步骤 %d 操作 %d' % (
    fmt(total), len(tree), sum(len(v) for v in tree.values()),
    sum(len(o) for v in tree.values() for o in v.values())))
for (hno, hnm), steps in tree.items():
    hs = sum(q for ops in steps.values() for q in ops.values())
    print('  %s %-8s %5s分  (步骤%d 操作%d)' % (hno, hnm, fmt(hs), len(steps),
          sum(len(o) for o in steps.values())))
