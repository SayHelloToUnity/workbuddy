#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""SRT 片段解析与文本重排的公共工具。"""
import os
import re


def srt_segments(path):
    """读取 srt，返回 [(start_sec, text), ...]。"""
    out = []
    if not os.path.exists(path):
        return out
    for block in open(path, encoding="utf-8").read().split("\n\n"):
        lines = [l.strip() for l in block.strip().split("\n") if l.strip()]
        if len(lines) < 3:
            continue
        m = re.match(r"(?:(\d+):)?(\d+):([\d.]+)\s*-->", lines[1])
        if not m:
            continue
        text = "".join(lines[2:]).strip()
        if text:
            h = int(m.group(1) or 0)
            out.append((h * 3600 + int(m.group(2)) * 60 + float(m.group(3)), text))
    return out


def clauses(segs):
    """按标点切成短分句，保留标点。"""
    out = []
    for _, t in segs:
        for c in re.split(r"(?<=[，,。？！；])", t):
            c = c.strip()
            if len(c) >= 3:
                out.append(c)
    return out


def repack(segs, hi=90):
    """把分句重新合并成不超过 hi 字的自然段。"""
    paras, buf = [], ""
    for c in clauses(segs):
        if not buf:
            buf = c
        elif len(buf) + len(c) <= hi:
            buf += c
        else:
            paras.append(buf)
            buf = c
        if re.search(r"[。？！?!]$", buf) and len(buf) >= hi * 0.5:
            paras.append(buf)
            buf = ""
    if buf:
        paras.append(buf)
    return paras
