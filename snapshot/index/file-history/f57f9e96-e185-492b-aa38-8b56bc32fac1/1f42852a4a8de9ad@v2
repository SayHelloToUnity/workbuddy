# -*- coding: utf-8 -*-
import zipfile, json, sys
from xml.etree import ElementTree as ET
from collections import OrderedDict

NS = '{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'
PATH = r'C:/Users/56583/Desktop/静脉输液手术数据/静脉 输液2026.10.22.xlsx'

z = zipfile.ZipFile(PATH)
ss = [''.join(t.text or '' for t in si.iter(NS+'t'))
      for si in ET.fromstring(z.read('xl/sharedStrings.xml'))]
sh = ET.fromstring(z.read('xl/worksheets/sheet1.xml'))

cells = {}
for row in sh.iter(NS+'row'):
    for c in row.findall(NS+'c'):
        ref = c.get('r')
        col = ''.join(ch for ch in ref if ch.isalpha())
        rn = int(''.join(ch for ch in ref if ch.isdigit()))
        v = c.find(NS+'v'); t = c.get('t')
        val = None
        if v is not None:
            val = ss[int(v.text)] if t == 's' else v.text
        cells[(rn, col)] = val

def g(r, col):
    v = cells.get((r, col))
    if v is None: return ''
    s = str(v).strip()
    if s.endswith('.0'): s = s[:-2]
    return s

# 找数据行
rows = [r for r in range(2, 400) if g(r, 'A')]
print('数据行数', len(rows), '范围', rows[0], rows[-1])
print('表头:', [g(1, c) for c in ['A','B','C','E','F','G','H','I','J','K','L','P','Q','R','S']])

# 构建层级
tree = OrderedDict()
for r in rows:
    I, J = g(r, 'I'), g(r, 'J')
    G_, H = g(r, 'G'), g(r, 'H')
    E, F = g(r, 'E'), g(r, 'F')
    Q, R, S = g(r, 'Q'), g(r, 'R'), g(r, 'S')
    P = g(r, 'P')
    env = tree.setdefault((I, J), OrderedDict())
    stp = env.setdefault((G_, H), OrderedDict())
    op = stp.setdefault((E, F), {'Q': set(), 'R': set(), 'S': set(), 'rows': [], 'P': []})
    op['Q'].add(Q); op['R'].add(R); op['S'].add(S)
    op['rows'].append(r); op['P'].append(P)

out = []
tot_s = 0.0
for (I, J), steps in tree.items():
    Sset = set()
    for (G_, H), ops in steps.items():
        for (E, F), d in ops.items():
            Sset |= d['S']
    S = sorted(Sset) if Sset else ['']
    s_val = float(S[0]) if len(S) == 1 and S[0] else 0.0
    if len(S) > 1:
        print(f'!! 环节{I} S 多值 {S}')
    tot_s += s_val
    env_node = {'code': I, 'name': J, 'S': S, 'steps': []}
    for (G_, H), ops in steps.items():
        Rset = set()
        for d in ops.values(): Rset |= d['R']
        Rl = sorted(Rset)
        if len(Rl) > 1:
            print(f'!! 步骤{I}-{G_} {H} R 多值 {Rl}')
        r_val = float(Rl[0]) if len(Rl) == 1 and Rl[0] else 0.0
        stp_node = {'code': G_, 'name': H, 'R': Rl, 'ops': []}
        qsum = 0.0
        for (E, F), d in ops.items():
            Ql = sorted(d['Q'])
            if len(Ql) > 1:
                print(f'!! 操作{I}-{G_}-{E} {F} Q 多值 {Ql}')
            q_val = float(Ql[0]) if len(Ql) == 1 and Ql[0] else 0.0
            qsum += q_val
            stp_node['ops'].append({'code': E, 'name': F, 'Q': Ql, 'rows': d['rows'], 'P': d['P']})
        stp_node['qsum'] = qsum
        env_node['steps'].append(stp_node)
    env_node['sumR'] = sum(float(s['R'][0]) if len(s['R']) == 1 and s['R'][0] else 0 for s in env_node['steps'])
    out.append(env_node)

print()
print('=' * 70)
for e in out:
    print(f"环节 {e['code']} {e['name']}  S={e['S']}  ΣR={e['sumR']}")
    for s in e['steps']:
        print(f"   步骤 {s['code']} {s['name']}  R={s['R']}  ΣQ={s['qsum']}")
        for o in s['ops']:
            print(f"      操作 {o['code']} {o['name']}  Q={o['Q']}  行{o['rows']}  P={o['P']}")
print('=' * 70)
print('S 合计 =', tot_s)

json.dump(out, open(r'C:/Users/56583/AppData/Local/Temp/tree.json', 'w', encoding='utf-8'),
          ensure_ascii=False, indent=1)
