# -*- coding: utf-8 -*-
"""解析 emmx 脑图节点文本，并与 xlsx 结构配对"""
import zipfile, re, json
from xml.etree import ElementTree as ET

EMMX = r'C:/Users/56583/Desktop/静脉输液手术数据/静脉输液评分结构图.emmx'
XLSX = r'C:/Users/56583/Desktop/静脉输液手术数据/静脉 输液2026.10.22.xlsx'
NS = '{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'

# ---------- 1. 读脑图文本 ----------
z = zipfile.ZipFile(EMMX)
txt = z.read('mmpage/page.bin').decode('utf-8', errors='replace')
segs = re.findall(r'[\u4e00-\u9fa5A-Za-z0-9 \-（）()、：:·\.]{2,}', txt)

nodes = []   # 按出现顺序：[(code, name, score)] code 可能 None（根）
root_text = None
for s in segs:
    s = s.strip()
    if s.startswith('静脉输液评分结构'):
        root_text = s
        nodes.append(('ROOT', s, None))
        continue
    m = re.match(r'^(\d{2})\s+(.+?)\s+(\d+(?:\.\d+)?)分$', s)
    if m:
        nodes.append((m.group(1), m.group(2).strip(), float(m.group(3))))

print('脑图根节点:', root_text)
print('脑图节点数(含根):', len(nodes))

# ---------- 2. 读表格结构 ----------
z2 = zipfile.ZipFile(XLSX)
ss = [''.join(t.text or '' for t in si.iter(NS + 't'))
      for si in ET.fromstring(z2.read('xl/sharedStrings.xml'))]
sh = ET.fromstring(z2.read('xl/worksheets/sheet1.xml'))
cells = {}
for row in sh.iter(NS + 'row'):
    for c in row.findall(NS + 'c'):
        ref = c.get('r')
        col = ''.join(ch for ch in ref if ch.isalpha())
        rn = int(''.join(ch for ch in ref if ch.isdigit()))
        v = c.find(NS + 'v'); t = c.get('t')
        val = None
        if v is not None:
            val = ss[int(v.text)] if t == 's' else v.text
        cells[(rn, col)] = val

def g(r, col):
    v = cells.get((r, col))
    if v is None: return ''
    s = str(v).strip()
    if s.endswith('.0'): s = s[:-2]
    return s

rows = [r for r in range(2, 400) if g(r, 'A')]
print('表格数据行:', len(rows), rows[0], '-', rows[-1])

# 结构：环节 -> 步骤 -> 操作
struct = []   # [(I,J),[ (G,H), [ (E,F), [rows] ] ] ]
idx_env, idx_stp, idx_op = {}, {}, {}
for r in rows:
    I, J = g(r, 'I'), g(r, 'J')
    G_, H = g(r, 'G'), g(r, 'H')
    E, F = g(r, 'E'), g(r, 'F')
    if (I, J) not in idx_env:
        idx_env[(I, J)] = len(struct)
        struct.append({'I': I, 'J': J, 'steps': [], 'rows': []})
    e = struct[idx_env[(I, J)]]
    e['rows'].append(r)
    key_s = (I, J, G_, H)
    if key_s not in idx_stp:
        idx_stp[key_s] = len(e['steps'])
        e['steps'].append({'G': G_, 'H': H, 'ops': [], 'rows': []})
    s_ = e['steps'][idx_stp[key_s]]
    s_['rows'].append(r)
    key_o = (I, J, G_, H, E, F)
    if key_o not in idx_op:
        idx_op[key_o] = len(s_['ops'])
        s_['ops'].append({'E': E, 'F': F, 'rows': [], 'Q': g(r, 'Q')})
    s_['ops'][idx_op[key_o]]['rows'].append(r)

print('表格结构: 环节%d 步骤%d 操作%d' % (
    len(struct), sum(len(e['steps']) for e in struct),
    sum(len(o['ops']) for e in struct for o in e['steps'])))

# ---------- 3. DFS 前序配对 ----------
expect = []   # [(level, I/J/G, code, name, ref)]
expect.append(('ROOT', None, None, None, None))
for e in struct:
    expect.append(('ENV', e, e['I'], e['J'], None))
    for s_ in e['steps']:
        expect.append(('STP', s_, s_['G'], s_['H'], None))
        for o in s_['ops']:
            expect.append(('OP', o, o['E'], o['F'], None))

print('期望节点数:', len(expect), ' 脑图节点数:', len(nodes))
if len(expect) != len(nodes):
    print('!! 节点数不一致，结构可能被改动')

n = min(len(expect), len(nodes))
mismatch = []
for i in range(1, n):
    lv, obj, code, name, _ = expect[i]
    mcode, mname, mscore = nodes[i]
    if str(mcode).strip() != str(code).strip() or mname != name:
        mismatch.append((i, lv, code, name, mcode, mname))
print('编号/名称不匹配数:', len(mismatch))
for m in mismatch[:20]:
    print('   位置%3d %-4s 表格[%s %s] vs 脑图[%s %s]' % m)

# ---------- 4. 汇总新分值 ----------
result = []
total = 0.0
for i, (lv, obj, code, name, _) in enumerate(expect):
    if lv == 'OP':
        obj['newQ'] = nodes[i][2]

for e in struct:
    e['newS'] = sum(o['newQ'] for s_ in e['steps'] for o in s_['ops'])
    for s_ in e['steps']:
        s_['newR'] = sum(o['newQ'] for o in s_['ops'])
    total += e['newS']

print('\n新分值合计: %.2f' % total)
print()
print('%-6s %-12s %8s %8s | %-6s %-12s %6s %6s' % (
    '环节', '名称', '脑图S', '重算S', '步骤', '名称', '脑图R', '重算R'))
pos = 1
for e in struct:
    env_map = nodes[pos][2]; pos += 1
    print('%-6s %-12s %8s %8s' % (e['I'], e['J'], env_map, e['newS']), end='')
    first = True
    for s_ in e['steps']:
        stp_map = nodes[pos][2]; pos += 1
        pos += len(s_['ops'])
        if first:
            print('  | %-6s %-12s %6s %6s' % (s_['G'], s_['H'], stp_map, s_['newR']))
            first = False
        else:
            print('%-6s %-12s %8s %8s  | %-6s %-12s %6s %6s' % (
                '', '', '', '', s_['G'], s_['H'], stp_map, s_['newR']))

json.dump({'struct': struct, 'total': total, 'rootText': root_text},
          open(r'C:/Users/56583/AppData/Local/Temp/newscore.json', 'w', encoding='utf-8'),
          ensure_ascii=False, indent=1)
